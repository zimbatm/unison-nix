-- unix: Unison as a frontend to Nix.
--
-- Packages are plain Unison values. We compute Nix derivations as
-- JSON, feed them to `nix derivation add`, and build the returned
-- .drv path with `nix build`. The Nix expression language is never
-- involved.
--
-- All outputs are floating content-addressed (ca-derivations). The
-- daemon computes output paths, so we never implement Nix's store
-- path hashing. We only need two placeholder hashes, verified
-- against Nix 2.35:
--   own output:  nixbase32(sha256("nix-output:<output>"))
--   dep output:  nixbase32(sha256("nix-upstream-output:<drvhash>:<name>"))

-- ----------------------------------------------------------------
-- Nix base32. Not RFC 4648: custom alphabet, bits read in reverse.

unix.base32.alphabet : [Char]
unix.base32.alphabet = Text.toCharList "0123456789abcdfghijklmnpqrsvwxyz"

unix.base32.encode : Bytes -> Text
unix.base32.encode bs =
  n = Bytes.size bs
  byte = j -> Optional.getOrElse 0 (Bytes.at j bs)
  len = Nat.diff (n * 8) 1 / 5 + 1
  charFor = i -> let
    b = i * 5
    j = b / 8
    bit = mod b 8
    hi = if j + 1 < n then Nat.shiftLeft (byte (j + 1)) (Nat.diff 8 bit) else 0
    c = Nat.and (Nat.or (Nat.shiftRight (byte j) bit) hi) 31
    Optional.getOrElse ?0 (List.at c unix.base32.alphabet)
  List.range 0 len
    |> List.map charFor
    |> List.reverse
    |> Text.fromCharList

unix.sha256 : Text -> Bytes
unix.sha256 t =
  crypto.hashBytes crypto.HashAlgorithm.Sha2_256 (Text.toUtf8 t)

-- Placeholder for one of our own outputs ($out in build scripts).
unix.placeholder : Text -> Text
unix.placeholder output =
  "/" ++ unix.base32.encode (unix.sha256 ("nix-output:" ++ output))

-- Placeholder for the output of a dependency .drv. Nix rewrites it
-- to the real store path once the dependency is built.
unix.upstreamPlaceholder : Text -> Text -> Text
unix.upstreamPlaceholder drvPath output =
  hashPart = Text.take 32 (Text.drop 11 drvPath)
  base = Text.drop 44 drvPath
  drvName = Text.take (Nat.diff (Text.size base) 4) base
  refName = if output == "out" then drvName else drvName ++ "-" ++ output
  "/" ++ unix.base32.encode
    (unix.sha256 ("nix-upstream-output:" ++ hashPart ++ ":" ++ refName))

-- ----------------------------------------------------------------
-- The package model. This is the whole "language": a package is a
-- name, a shell script, and dependencies. A dependency is either
-- another Pkg or a nixpkgs attribute. Scripts refer to a
-- dependency's output as @depname@ / @attr@.
--
-- Nixpkgs deps work because their derivations are input-addressed:
-- output paths are fixed at eval time, so we splice the literal
-- store path and list the .drv in inputs. No placeholder needed.

-- Fetch is name, url, SRI hash. It becomes a fixed-output
-- derivation: the sandbox gets network, the daemon checks the hash.

type unix.Dep = Local unix.Pkg | Nixpkgs Text | Fetch Text Text Text

type unix.Pkg = { name : Text, script : Text, deps : [unix.Dep] }

unix.system : Text
unix.system = "x86_64-linux"

-- Output sections. Floating CA: the daemon computes the path.
-- Fixed: we give the SRI hash of the file, the daemon derives the
-- path from it.

unix.caOutputs : Json
unix.caOutputs =
  Json.object
    [ ( "out"
      , Json.object
          [ ("hashAlgo", Json.text "sha256")
          , ("method", Json.text "nar")
          ]
      )
    ]

unix.fixedOutputs : Text -> Json
unix.fixedOutputs sri =
  Json.object
    [ ( "out"
      , Json.object [("hash", Json.text sri), ("method", Json.text "flat")]
      )
    ]

-- Group (drvPath, outputName) pairs by drvPath so the same .drv
-- never appears twice in inputs.drvs.
unix.groupDeps : [(Text, Text)] -> [(Text, [Text])]
unix.groupDeps ps =
  add = acc -> p -> match p with
    (drvPath, outName) ->
      match unix.assoc.lookup drvPath acc with
        Some outs ->
          if List.any (o -> o Text.== outName) outs then acc
          else
            List.map
              (q -> match q with
                (k, v) -> if k == drvPath then (k, v :+ outName) else (k, v))
              acc
        None -> acc :+ (drvPath, [outName])
  List.foldLeft add [] ps

-- With structured attrs the daemon does not export env vars. The
-- builder reads .attrs.sh instead. This prelude defines $out (and
-- any future outputs) for the package script. Needs bash: .attrs.sh
-- uses declare -A, which busybox sh cannot parse.
unix.attrsPrelude : Text
unix.attrsPrelude =
  Text.join
    "\n"
    [ ". \"$NIX_ATTRS_SH_FILE\""
    , "for o in \"${!outputs[@]}\"; do export \"$o=${outputs[$o]}\"; done"
    , ""
    ]

-- Derivation JSON, schema version 4 (Nix 2.35). Structured attrs
-- out of the box: env carries only the output paths, everything
-- else lives in structuredAttrs / the .attrs files. Deps are
-- (drvPath, outputName) pairs. outEnv is $out as stored in env: a
-- floating-CA placeholder, or "" for fixed outputs -- the daemon
-- replaces "" with the computed path on `derivation add`.
unix.drvJson' : Text -> Text -> Text -> [(Text, Text)] -> Text -> Json -> Text
unix.drvJson' name builder script depDrvs outEnv outputsJson =
  inputDrv = p -> match p with
    (drvPath, outNames) ->
      ( Text.drop 11 drvPath
      , Json.object
          [ ("dynamicOutputs", Json.object [])
          , ("outputs", Json.array (List.map Json.text outNames))
          ]
      )
  Json.toText
    (Json.object
      [ ( "args"
        , Json.array
            [Json.text "-c", Json.text (unix.attrsPrelude ++ script)]
        )
      , ("builder", Json.text builder)
      , ("env", Json.object [("out", Json.text outEnv)])
      , ( "inputs"
        , Json.object
            [ ( "drvs"
              , Json.object (List.map inputDrv (unix.groupDeps depDrvs))
              )
            , ("srcs", Json.array [])
            ]
        )
      , ("name", Json.text name)
      , ("outputs", outputsJson)
      , ( "structuredAttrs"
        , Json.object
            [ ("builder", Json.text builder)
            , ("name", Json.text name)
            , ("outputs", Json.array [Json.text "out"])
            , ("system", Json.text unix.system)
            ]
        )
      , ("system", Json.text unix.system)
      , ("version", Json.nat 4)
      ])

unix.drvJson : Text -> Text -> Text -> [(Text, Text)] -> Text
unix.drvJson name builder script depDrvs =
  unix.drvJson' name builder script depDrvs (unix.placeholder "out")
    unix.caOutputs

-- ----------------------------------------------------------------
-- Talking to Nix.

unix.exec : Text -> [Text] -> Text -> {IO, Exception} Text
unix.exec cmd args input =
  (stdin, stdout, stderr, proc) = IO.Process.start cmd args
  Handle.putText stdin input
  Handle.close stdin
  out = Handle.getText stdout
  err = Handle.getText stderr
  code = IO.Process.wait proc
  match code with
    0 -> out
    _ ->
      Exception.raise
        (Generic.failure
          ("exec failed (" ++ Nat.toText code ++ "): " ++ cmd ++ " "
            ++ Text.join " " args ++ "\n" ++ err)
          ())

unix.nix : [Text] -> Text -> {IO, Exception} Text
unix.nix args input =
  unix.exec
    "nix"
    (["--extra-experimental-features", "nix-command ca-derivations"] ++ args)
    input

unix.chomp : Text -> Text
unix.chomp = Text.replaceAll "\n" ""

unix.addDrv : Text -> {IO, Exception} Text
unix.addDrv j = unix.chomp (unix.nix ["derivation", "add"] j)

-- Ask the Nix evaluator for one nixpkgs attribute. One call returns
-- drv path, output path, and output name. Forcing drvPath also
-- writes the .drv into the store. The Nix language runs here, but
-- only as an importer -- like `guix import`.
unix.evalNixpkgs : Text -> {IO, Exception} (Text, Text, Text)
unix.evalNixpkgs attr =
  out =
    unix.nix
      [ "eval", "--raw", "nixpkgs#" ++ attr
      , "--apply", "p: \"${p.drvPath}\\n${p.outPath}\\n${p.outputName}\""
      ]
      ""
  match Text.split ?\n out with
    [drvPath, outPath, outName] -> (drvPath, outPath, outName)
    _ ->
      Exception.raise
        (Generic.failure ("unexpected eval output for " ++ attr) ())

-- ----------------------------------------------------------------
-- The pinned index. `nixpkgs.index` lives in the ucm codebase (see
-- src/nixpkgs-index.u, regenerated by `./run.sh index`). One batch
-- eval per nixpkgs revision; after that, resolving an attr is a
-- pure lookup plus a file-exists check. The Nix evaluator only
-- runs on an index miss, or when the .drv was garbage-collected.

unix.index.lookup :
  Text -> [(Text, Text, Text, Text)] -> Optional (Text, Text, Text)
unix.index.lookup attr xs = match xs with
  [] -> None
  (a, d, o, n) +: rest ->
    if a Text.== attr then Some (d, o, n)
    else unix.index.lookup attr rest

unix.resolveNixpkgs : Text -> {IO, Exception} (Text, Text, Text)
unix.resolveNixpkgs attr =
  hit = match unix.index.lookup attr nixpkgs.index with
    Some (d, o, n) ->
      if FilePath.exists (FilePath d) then Some (d, o, n) else None
    None -> None
  match hit with
    Some t -> t
    None ->
      printLine ("  eval " ++ attr ++ " (index miss)")
      unix.evalNixpkgs attr

-- Attrs the demo package set needs. `./run.sh index` evaluates all
-- of them in a single nix eval call.
unix.index.attrs : [Text]
unix.index.attrs =
  [ "bash", "cacert", "coreutils", "curl", "gawk", "gcc", "gettext"
  , "gnugrep", "gnumake", "gnused", "gnutar", "gzip", "hello"
  , "unison-ucm"
  ]

unix.index.generate : '{IO, Exception} ()
unix.index.generate = do
  meta = Json.fromText (unix.nix ["flake", "metadata", "nixpkgs", "--json"] "")
  rev =
    unix.json.asText
      (unix.json.get "narHash" (unix.json.get "locked" meta))
  quoted = Text.join " " (List.map (a -> "\"" ++ a ++ "\"") unix.index.attrs)
  expr =
    "pkgs: builtins.concatStringsSep \"\\n\" (map (a: let p = pkgs.${a}; in \"${a}|${p.drvPath}|${p.outPath}|${p.outputName}\") [ "
      ++ quoted ++ " ])"
  out =
    unix.nix
      [ "eval", "--raw", "nixpkgs#legacyPackages." ++ unix.system
      , "--apply", expr
      ]
      ""
  entry = l -> match Text.split ?| l with
    [a, d, o, n] ->
      "(\"" ++ a ++ "\", \"" ++ d ++ "\", \"" ++ o ++ "\", \"" ++ n ++ "\")"
    _ ->
      Exception.raise (Generic.failure ("bad index line: " ++ l) ())
  tuples = List.map entry (Text.split ?\n out)
  body = match tuples with
    [] -> "  []"
    first +: rest ->
      "  [ " ++ first
        ++ Text.join "" (List.map (t -> "\n  , " ++ t) rest)
        ++ "\n  ]"
  txt =
    Text.join
      "\n"
      [ "-- Generated by ./run.sh index. Do not edit by hand."
      , "-- One batch eval per nixpkgs revision; use time is eval-free."
      , ""
      , "nixpkgs.index.rev : Text"
      , "nixpkgs.index.rev = \"" ++ rev ++ "\""
      , ""
      , "nixpkgs.index : [(Text, Text, Text, Text)]"
      , "nixpkgs.index ="
      , body
      , ""
      ]
  writeFileUtf8 (FilePath "src/nixpkgs-index.u") txt

-- Realise a source fetch as a fixed-output derivation. curl and
-- CA certs come from nixpkgs. The output path is fixed by the SRI
-- hash alone; we read it back from the daemon instead of
-- implementing store-path hashing.
unix.fetch : Text -> Text -> Text -> {IO, Exception} (Text, Text)
unix.fetch name url sri =
  (bashDrv, bashOut, bashOutName) = unix.resolveNixpkgs "bash"
  (curlDrv, curlOut, curlOutName) = unix.resolveNixpkgs "curl"
  (certDrv, certOut, certOutName) = unix.resolveNixpkgs "cacert"
  script =
    "export SSL_CERT_FILE=" ++ certOut ++ "/etc/ssl/certs/ca-bundle.crt; "
      ++ curlOut ++ "/bin/curl --fail --location --output \"$out\" " ++ url
  drvPath =
    unix.addDrv
      (unix.drvJson'
        name
        (bashOut ++ "/bin/bash")
        script
        [ (bashDrv, bashOutName)
        , (curlDrv, curlOutName)
        , (certDrv, certOutName)
        ]
        ""
        (unix.fixedOutputs sri))
  outPath =
    unix.chomp (unix.exec "nix-store" ["--query", "--outputs", drvPath] "")
  (drvPath, outPath)

unix.assoc.lookup : Text -> [(Text, a)] -> Optional a
unix.assoc.lookup k xs = match xs with
  [] -> None
  (k2, v) +: rest ->
    if k == k2 then Some v else unix.assoc.lookup k rest

-- ----------------------------------------------------------------
-- Realisation: walk the graph depth-first, add each derivation to
-- the store once, substitute output references into scripts. Local
-- deps get a floating-CA upstream placeholder. Nixpkgs deps get
-- their literal (input-addressed) output path.
--
-- A resolved dep is (name, drvPath, outputName, substText).

unix.realise : unix.Pkg -> {IO, Exception} Text
unix.realise pkg = at2 (unix.realise.go [] pkg)

-- Resolve a dep list to (name, drvPath, outputName, substText)
-- tuples. Local deps realise recursively (cache threads through);
-- their substText is an upstream placeholder. Nixpkgs and Fetch
-- deps have literal paths.
unix.resolveDeps :
  [(Text, Text)] -> [unix.Dep]
    -> {IO, Exception} ([(Text, Text)], [(Text, Text, Text, Text)])
unix.resolveDeps cache deps =
  step = acc -> dep -> match acc with
    (c, resolved) -> match dep with
      unix.Dep.Local p ->
        (c2, drvPath) = unix.realise.go c p
        sub = unix.upstreamPlaceholder drvPath "out"
        (c2, resolved :+ (unix.Pkg.name p, drvPath, "out", sub))
      unix.Dep.Nixpkgs attr ->
        (drvPath, outPath, outName) = unix.resolveNixpkgs attr
        printLine ("  nixpkgs " ++ attr ++ " -> " ++ drvPath)
        (c, resolved :+ (attr, drvPath, outName, outPath))
      unix.Dep.Fetch fname url sri ->
        (drvPath, outPath) = unix.fetch fname url sri
        printLine ("  fetch " ++ fname ++ " -> " ++ drvPath)
        (c, resolved :+ (fname, drvPath, "out", outPath))
  List.foldLeft step (cache, []) deps

unix.realise.go :
  [(Text, Text)] -> unix.Pkg -> {IO, Exception} ([(Text, Text)], Text)
unix.realise.go cache pkg = match pkg with
  unix.Pkg.Pkg name script deps ->
    match unix.assoc.lookup name cache with
      Some path -> (cache, path)
      None ->
        (cache2, resolvedDeps) = unix.resolveDeps cache deps
        subst = s -> info -> match info with
          (depName, _, _, sub) ->
            Text.replaceAll ("@" ++ depName ++ "@") sub s
        script' = List.foldLeft subst script resolvedDeps
        depDrv = info -> match info with
          (_, drvPath, outName, _) -> (drvPath, outName)
        (bashDrv, bashOut, bashOutName) = unix.resolveNixpkgs "bash"
        depDrvs = List.map depDrv resolvedDeps :+ (bashDrv, bashOutName)
        drvPath =
          unix.addDrv
            (unix.drvJson name (bashOut ++ "/bin/bash") script' depDrvs)
        printLine ("  drv " ++ name ++ " -> " ++ drvPath)
        (cache2 :+ (name, drvPath), drvPath)

-- ----------------------------------------------------------------
-- Typed derivations. `nix derivation show` emits the same schema
-- version 4 JSON that `nix derivation add` accepts, so a nixpkgs
-- derivation round-trips through a plain Unison value. An override
-- is then a pure Drv -> Drv function. No overrideAttrs, no
-- fixpoints, no mkDerivation magic.

-- An output is input-addressed (basename of the store path, fixed
-- at eval time), floating CA (daemon computes the path), or fixed
-- (SRI hash + method).
type unix.Out = Addressed Text | Floating | Fixed Text Text

type unix.Drv =
  { name : Text
  , system : Text
  , builder : Text
  , args : [Text]
  , env : [(Text, Text)]
  , inputDrvs : [(Text, [Text])]
  , inputSrcs : [Text]
  , outputs : [(Text, unix.Out)]
  , attrs : Optional Json
  }

-- Small Json access kit. The lib exposes the constructors, so this
-- is all we need instead of a decoder framework.

unix.json.get : Text -> Json -> {Exception} Json
unix.json.get k j = match j with
  Json.Object kvs -> match unix.assoc.lookup k kvs with
    Some v -> v
    None -> Exception.raise (Generic.failure ("json: missing key " ++ k) ())
  _ -> Exception.raise (Generic.failure ("json: not an object at " ++ k) ())

unix.json.opt : Text -> Json -> Optional Json
unix.json.opt k j = match j with
  Json.Object kvs -> unix.assoc.lookup k kvs
  _ -> None

unix.json.asText : Json -> {Exception} Text
unix.json.asText j = match j with
  Json.Text t -> t
  _ -> Exception.raise (Generic.failure "json: not a string" ())

unix.json.asArray : Json -> {Exception} [Json]
unix.json.asArray j = match j with
  Json.Array xs -> xs
  _ -> Exception.raise (Generic.failure "json: not an array" ())

unix.json.asObject : Json -> {Exception} [(Text, Json)]
unix.json.asObject j = match j with
  Json.Object kvs -> kvs
  _ -> Exception.raise (Generic.failure "json: not an object" ())

-- Rewrite every string leaf. Keys stay as they are.
unix.json.mapText : (Text -> Text) -> Json -> Json
unix.json.mapText f j = match j with
  Json.Text t -> Json.Text (f t)
  Json.Array xs -> Json.Array (List.map (unix.json.mapText f) xs)
  Json.Object kvs ->
    Json.Object
      (List.map (p -> match p with (k, v) -> (k, unix.json.mapText f v)) kvs)
  _ -> j

-- Upsert a key in a Json object. Non-objects pass through.
unix.json.set : Text -> Json -> Json -> Json
unix.json.set k v j = match j with
  Json.Object kvs ->
    if List.any (p -> at1 p Text.== k) kvs
    then
      Json.Object
        (List.map
          (p -> match p with
            (k2, v2) -> if k2 Text.== k then (k2, v) else (k2, v2))
          kvs)
    else Json.Object (kvs :+ (k, v))
  _ -> j

unix.Drv.fromJson : Json -> {Exception} unix.Drv
unix.Drv.fromJson j =
  texts = xs -> List.map unix.json.asText (unix.json.asArray xs)
  pairText = p -> match p with (k, v) -> (k, unix.json.asText v)
  out = o -> match unix.json.opt "path" o with
    Some p -> unix.Out.Addressed (unix.json.asText p)
    None -> match unix.json.opt "hash" o with
      Some h ->
        unix.Out.Fixed
          (unix.json.asText h)
          (unix.json.asText (unix.json.get "method" o))
      None -> unix.Out.Floating
  inputs = unix.json.get "inputs" j
  drvIn = p -> match p with
    (k, v) -> (k, texts (unix.json.get "outputs" v))
  unix.Drv.Drv
    (unix.json.asText (unix.json.get "name" j))
    (unix.json.asText (unix.json.get "system" j))
    (unix.json.asText (unix.json.get "builder" j))
    (texts (unix.json.get "args" j))
    (List.map pairText (unix.json.asObject (unix.json.get "env" j)))
    (List.map drvIn (unix.json.asObject (unix.json.get "drvs" inputs)))
    (texts (unix.json.get "srcs" inputs))
    (List.map
      (p -> match p with (k, v) -> (k, out v))
      (unix.json.asObject (unix.json.get "outputs" j)))
    (unix.json.opt "structuredAttrs" j)

unix.Drv.toJson : unix.Drv -> Json
unix.Drv.toJson d = match d with
  unix.Drv.Drv name system builder args env inDrvs inSrcs outputs attrs ->
    outJson = o -> match o with
      unix.Out.Addressed p -> Json.object [("path", Json.text p)]
      unix.Out.Floating ->
        Json.object
          [("hashAlgo", Json.text "sha256"), ("method", Json.text "nar")]
      unix.Out.Fixed h m ->
        Json.object [("hash", Json.text h), ("method", Json.text m)]
    inDrv = p -> match p with
      (k, outs) ->
        ( k
        , Json.object
            [ ("dynamicOutputs", Json.object [])
            , ("outputs", Json.array (List.map Json.text outs))
            ]
        )
    kv = p -> match p with (k, v) -> (k, Json.text v)
    base =
      [ ("args", Json.array (List.map Json.text args))
      , ("builder", Json.text builder)
      , ("env", Json.object (List.map kv env))
      , ( "inputs"
        , Json.object
            [ ("drvs", Json.object (List.map inDrv inDrvs))
            , ("srcs", Json.array (List.map Json.text inSrcs))
            ]
        )
      , ("name", Json.text name)
      , ( "outputs"
        , Json.object
            (List.map (p -> match p with (k, v) -> (k, outJson v)) outputs)
        )
      ]
    withAttrs = match attrs with
      Some a -> base :+ ("structuredAttrs", a)
      None -> base
    Json.object
      (withAttrs ++ [("system", Json.text system), ("version", Json.nat 4)])

-- Turn an input-addressed derivation into a floating CA one. The
-- old output paths become placeholders everywhere, and the daemon
-- computes fresh paths at build time. This is what makes a mutated
-- nixpkgs derivation buildable: its identity changed, so its old
-- output paths are lies, and CA sidesteps recomputing them.
unix.Drv.caify : unix.Drv -> unix.Drv
unix.Drv.caify d =
  subs =
    List.foldLeft
      (acc -> p -> match p with
        (oname, unix.Out.Addressed path) ->
          acc :+ ("/nix/store/" ++ path, unix.placeholder oname)
        _ -> acc)
      []
      (unix.Drv.outputs d)
  swap = t -> let
    List.foldLeft
      (s -> pr -> match pr with (old, new) -> Text.replaceAll old new s)
      t
      subs
  d
    |> unix.Drv.env.modify
         (List.map (p -> match p with (k, v) -> (k, swap v)))
    |> unix.Drv.args.modify (List.map swap)
    |> unix.Drv.attrs.modify (Optional.map (unix.json.mapText swap))
    |> unix.Drv.outputs.modify
         (List.map
           (p -> match p with
             (k, unix.Out.Fixed h m) -> (k, unix.Out.Fixed h m)
             (k, _) -> (k, unix.Out.Floating)))

unix.Drv.setEnv : Text -> Text -> unix.Drv -> unix.Drv
unix.Drv.setEnv k v d =
  upsert = kvs -> let
    if List.any (p -> at1 p Text.== k) kvs
    then
      List.map
        (p -> match p with
          (k2, v2) -> if k2 Text.== k then (k2, v) else (k2, v2))
        kvs
    else kvs :+ (k, v)
  unix.Drv.env.modify upsert d

unix.Drv.setAttr : Text -> Json -> unix.Drv -> unix.Drv
unix.Drv.setAttr k v d =
  unix.Drv.attrs.modify (Optional.map (unix.json.set k v)) d

unix.Drv.rename : Text -> unix.Drv -> unix.Drv
unix.Drv.rename n d =
  d |> unix.Drv.name.set n |> unix.Drv.setAttr "name" (Json.text n)

-- Import one nixpkgs derivation as a typed value.
unix.importDrv : Text -> {IO, Exception} unix.Drv
unix.importDrv attr =
  raw = unix.nix ["derivation", "show", "nixpkgs#" ++ attr] ""
  j = Json.fromText raw
  match unix.json.asObject (unix.json.get "derivations" j) with
    [(_, dj)] -> unix.Drv.fromJson dj
    _ ->
      Exception.raise
        (Generic.failure ("expected one derivation: " ++ attr) ())

unix.Drv.realise : unix.Drv -> {IO, Exception} Text
unix.Drv.realise d = unix.addDrv (Json.toText (unix.Drv.toJson d))

-- ----------------------------------------------------------------
-- Deep overrides: import a whole drv closure, override any node,
-- rewrite everything downstream. What nixpkgs does with
-- overrideAttrs and evaluator fixpoints is a pure graph
-- transformation here. Unaffected subgraphs keep their
-- input-addressed drvs and literal paths, so the binary cache
-- still serves them.

-- Closure keyed by drv basename, from `nix derivation show -r`.
unix.importClosure : Text -> {IO, Exception} [(Text, unix.Drv)]
unix.importClosure drvPath =
  raw = unix.nix ["derivation", "show", "-r", drvPath] ""
  j = Json.fromText raw
  ds = unix.json.asObject (unix.json.get "derivations" j)
  List.map (p -> match p with (b, dj) -> (b, unix.Drv.fromJson dj)) ds

-- Does node b transitively depend on a target? Memoized; nodes
-- outside the closure map count as unaffected.
unix.closure.mark :
  [(Text, unix.Drv)] -> (Text -> Boolean) -> [(Text, Boolean)] -> Text
    -> ([(Text, Boolean)], Boolean)
unix.closure.mark closure isTarget cache b =
  match unix.assoc.lookup b cache with
    Some r -> (cache, r)
    None ->
      if isTarget b then (cache :+ (b, true), true)
      else match unix.assoc.lookup b closure with
        None -> (cache :+ (b, false), false)
        Some d ->
          step = acc -> p -> match acc with
            (c, hit) -> match p with
              (i, _) ->
                (c2, r) = unix.closure.mark closure isTarget c i
                (c2, hit || r)
          (cache2, hit) =
            List.foldLeft step (cache, false) (unix.Drv.inputDrvs d)
          (cache2 :+ (b, hit), hit)

unix.closure.markAll :
  [(Text, unix.Drv)] -> [Text] -> [(Text, Boolean)]
unix.closure.markAll closure targets =
  isT = b -> List.any (t -> t Text.== b) targets
  List.foldLeft
    (c -> p -> at1 (unix.closure.mark closure isT c (at1 p)))
    []
    closure

-- Rewrite bottom-up. An affected drv gets: new inputDrvs keys for
-- its rewritten inputs, upstream placeholders in place of their old
-- literal output paths, the user override if it is a target, and
-- CA-ification. Returns the new drv path; the cache maps old
-- basename -> new drv path.
unix.closure.rewrite :
  [(Text, unix.Drv)] -> [(Text, Boolean)] -> [Text]
    -> (unix.Drv -> unix.Drv) -> [(Text, Text)] -> Text
    -> {IO, Exception} ([(Text, Text)], Text)
unix.closure.rewrite closure marks targets f cache b =
  affected = k -> Optional.getOrElse false (unix.assoc.lookup k marks)
  match unix.assoc.lookup b cache with
    Some p -> (cache, p)
    None ->
      if Boolean.not (affected b) then (cache, "/nix/store/" ++ b)
      else
        d = match unix.assoc.lookup b closure with
          Some d -> d
          None ->
            Exception.raise
              (Generic.failure ("not in closure: " ++ b) ())
        step = acc -> p -> match acc with
          (c, ins, subs) -> match p with
            (i, outs) ->
              if Boolean.not (affected i) then (c, ins :+ (i, outs), subs)
              else
                (c2, newPath) =
                  unix.closure.rewrite closure marks targets f c i
                iDrv = match unix.assoc.lookup i closure with
                  Some x -> x
                  None ->
                    Exception.raise
                      (Generic.failure ("not in closure: " ++ i) ())
                subFor = ss -> op -> match op with
                  (oname, unix.Out.Addressed pth) ->
                    ss
                      :+ ( "/nix/store/" ++ pth
                         , unix.upstreamPlaceholder newPath oname
                         )
                  _ -> ss
                subs2 = List.foldLeft subFor subs (unix.Drv.outputs iDrv)
                (c2, ins :+ (Text.drop 11 newPath, outs), subs2)
        (cache2, newIns, subs) =
          List.foldLeft step (cache, [], []) (unix.Drv.inputDrvs d)
        swap = t -> let
          List.foldLeft
            (s -> pr -> match pr with (o, n) -> Text.replaceAll o n s)
            t
            subs
        d1 =
          d
            |> unix.Drv.inputDrvs.set newIns
            |> unix.Drv.env.modify
                 (List.map (p -> match p with (k, v) -> (k, swap v)))
            |> unix.Drv.args.modify (List.map swap)
            |> unix.Drv.attrs.modify
                 (Optional.map (unix.json.mapText swap))
        d2 = if List.any (t -> t Text.== b) targets then f d1 else d1
        newPath = unix.Drv.realise (unix.Drv.caify d2)
        printLine ("  rewrite " ++ unix.Drv.name d ++ " -> " ++ newPath)
        (cache2 :+ (b, newPath), newPath)

-- ----------------------------------------------------------------
-- Unison as the builder language. The build script that runs
-- inside the sandbox is Unison too: compiled to .uc bytecode on
-- the host, added to the store, executed by nixpkgs' ucm with
-- `run.compiled`. The bash-like dialect is the Sh ability; its
-- handler runs in the sandbox with inherited stdio, so `run`
-- output lands in the build log.
--
-- Dependency paths and $out travel as plain env vars (PATH,
-- dep_<name>, out), because child processes need PATH in the real
-- environment anyway. The daemon rewrites the placeholders in env
-- like everywhere else.

ability unix.Sh where
  run : Text -> [Text] -> ()
  cd : Text -> ()
  out : Text
  dep : Text -> Text

unix.Sh.build : '{IO, Exception, unix.Sh} a -> {IO, Exception} a
unix.Sh.build prog =
  h = cases
    { r } -> r
    { unix.Sh.run cmd args -> k } ->
      printLine ("$ " ++ cmd ++ " " ++ Text.join " " args)
      code = IO.Process.call cmd args
      match code with
        0 -> handle k () with h
        _ ->
          Exception.raise
            (Generic.failure
              (cmd ++ " failed with exit code " ++ Nat.toText code)
              ())
    { unix.Sh.cd p -> k } ->
      FilePath.setCurrentDirectory (FilePath p)
      handle k () with h
    { unix.Sh.out -> k } -> handle k (IO.getEnv "out") with h
    { unix.Sh.dep n -> k } -> handle k (IO.getEnv ("dep_" ++ n)) with h
  handle !prog with h

-- A package built by Unison. The build script is a first-class
-- value, not a named term: realiseU ships the closure to the
-- sandbox the way distributed Unison ships closures to remote
-- nodes -- Value.serialize for the value, Code.serialize for the
-- transitive code of its dependencies. One generic runner (see
-- unix.Sh.runner) is compiled to bytecode once; it caches the
-- shipped code and loads the value.
type unix.UPkg =
  { name : Text
  , build : '{IO, Exception, unix.Sh} ()
  , deps : [unix.Dep]
  }

-- Transitive non-builtin code of a set of links. Builtins exist on
-- both sides and their code cannot serialize, so they are skipped.
unix.codeOf :
  [Link.Term] -> [(Link.Term, Code)] -> {IO, Exception} [(Link.Term, Code)]
unix.codeOf pending acc = match pending with
  [] -> acc
  link +: rest ->
    if List.any (p -> at1 p === link) acc then unix.codeOf rest acc
    else if Text.startsWith "##" (Link.Term.toText link) then
      unix.codeOf rest acc
    else match Code.lookup link with
      None -> unix.codeOf rest acc
      Some code ->
        unix.codeOf (rest ++ Code.dependencies code) (acc :+ (link, code))

-- Pack a value and the code it needs into one Bytes. The outer
-- envelope is plain data, so it loads anywhere.
unix.ship : a -> {IO, Exception} Bytes
unix.ship v =
  val = Value.value v
  bytes = Value.serialize_v4 val
  pairs =
    List.map
      (p -> match p with
        (l, c) -> (Value.serialize_v4 (Value.value l), Code.serialize_v3 c))
      (unix.codeOf (Value.dependencies val) [])
  Value.serialize_v4 (Value.value (bytes, pairs))

unix.unship : Bytes -> {IO, Exception} a
unix.unship b =
  bad = msg -> Exception.raise (Generic.failure msg ())
  (vb, pairs) = match Value.load (Value.deserialize b) with
    Left _ -> bad "unship: cannot load the envelope"
    Right e -> (e : (Bytes, [(Bytes, Bytes)]))
  toPair = p -> match p with
    (lb, cb) ->
      link = match Value.load (Value.deserialize lb) with
        Left _ -> bad "unship: cannot load a code link"
        Right l -> (l : Link.Term)
      (link, Code.deserialize cb)
  _ = Code.cache_ (List.map toPair pairs)
  match Value.load (Value.deserialize vb) with
    Left missing ->
      bad
        ("unship: still missing "
          ++ Text.join ", " (List.map Link.Term.toText missing))
    Right v -> v

-- The generic sandbox entrypoint: argv is the shipped script file.
unix.Sh.runner : '{IO, Exception} ()
unix.Sh.runner = do
  match !IO.getArgs with
    [file] ->
      script = unix.unship (readFile (FilePath file))
      unix.Sh.build (script : '{IO, Exception, unix.Sh} ())
    _ ->
      Exception.raise (Generic.failure "usage: runner <script.uv>" ())

-- Derivation JSON for a ucm-run builder: explicit args, env and
-- inputs.srcs, no structured attrs (env is the API here).
unix.drvJsonU :
  Text -> Text -> [Text] -> [(Text, Text)] -> [(Text, Text)] -> [Text]
    -> Text
unix.drvJsonU name builder args envs depDrvs srcs =
  inputDrv = p -> match p with
    (drvPath, outNames) ->
      ( Text.drop 11 drvPath
      , Json.object
          [ ("dynamicOutputs", Json.object [])
          , ("outputs", Json.array (List.map Json.text outNames))
          ]
      )
  Json.toText
    (Json.object
      [ ("args", Json.array (List.map Json.text args))
      , ("builder", Json.text builder)
      , ( "env"
        , Json.object
            (List.map (p -> match p with (k, v) -> (k, Json.text v)) envs)
        )
      , ( "inputs"
        , Json.object
            [ ( "drvs"
              , Json.object (List.map inputDrv (unix.groupDeps depDrvs))
              )
            , ( "srcs"
              , Json.array (List.map (s -> Json.text (Text.drop 11 s)) srcs)
              )
            ]
        )
      , ("name", Json.text name)
      , ("outputs", unix.caOutputs)
      , ("system", Json.text unix.system)
      , ("version", Json.nat 4)
      ])

unix.realiseU : unix.UPkg -> {IO, Exception} Text
unix.realiseU up = match up with
  unix.UPkg.UPkg name build deps ->
    (ucmDrv, ucmOut, ucmOutName) = unix.resolveNixpkgs "unison-ucm"
    (_, resolved) = unix.resolveDeps [] deps
    runnerPath =
      unix.chomp
        (unix.nix
          ["store", "add", "--mode", "flat", ".ucm-compiled/runner.uc"]
          "")
    scriptFile = ".ucm-compiled/script-" ++ name ++ ".uv"
    writeFile (FilePath scriptFile) (unix.ship build)
    uvPath =
      unix.chomp
        (unix.nix ["store", "add", "--mode", "flat", scriptFile] "")
    printLine ("  script " ++ name ++ " -> " ++ uvPath)
    pathEnv =
      Text.join
        ":"
        (List.map (i -> match i with (_, _, _, sub) -> sub ++ "/bin") resolved)
    depEnvs =
      List.map
        (i -> match i with (n, _, _, sub) -> ("dep_" ++ n, sub))
        resolved
    envs =
      [("PATH", pathEnv), ("out", unix.placeholder "out")] ++ depEnvs
    depDrv = i -> match i with (_, drvPath, outName, _) -> (drvPath, outName)
    depDrvs = List.map depDrv resolved :+ (ucmDrv, ucmOutName)
    drvPath =
      unix.addDrv
        (unix.drvJsonU
          name
          (ucmOut ++ "/bin/ucm")
          ["run.compiled", runnerPath, uvPath]
          envs
          depDrvs
          [runnerPath, uvPath])
    printLine ("  drv " ++ name ++ " -> " ++ drvPath)
    drvPath

-- ----------------------------------------------------------------
-- A tiny package set.

pkgs.greeting : unix.Pkg
pkgs.greeting =
  unix.Pkg.Pkg
    "greeting"
    "echo hello from the unison frontend > $out"
    []

pkgs.banner : unix.Pkg
pkgs.banner =
  unix.Pkg.Pkg
    "banner"
    "read -r line < @greeting@; { echo \"$line\"; echo this is nix without nixexpr; } > $out"
    [unix.Dep.Local pkgs.greeting]

-- Uses real nixpkgs packages: hello from the binary cache, tr from
-- coreutils. Mixes a local CA dep (banner) with nixpkgs deps.
pkgs.shout : unix.Pkg
pkgs.shout =
  unix.Pkg.Pkg
    "shout"
    "{ @hello@/bin/hello; @coreutils@/bin/tr a-z A-Z < @banner@; } > $out"
    [ unix.Dep.Nixpkgs "hello"
    , unix.Dep.Nixpkgs "coreutils"
    , unix.Dep.Local pkgs.banner
    ]

-- The milestone: compile GNU hello 2.12.1 from the upstream
-- tarball. nixpkgs ships 2.12.3, so this is not a replay -- the
-- source fetch and build are ours. Toolchain from nixpkgs.
pkgs.gnuhello : unix.Pkg
pkgs.gnuhello =
  script =
    Text.join
      "\n"
      [ "set -e"
      , "export PATH=@bash@/bin:@coreutils@/bin:@gnugrep@/bin:@gnused@/bin:@gawk@/bin:@gnutar@/bin:@gzip@/bin:@gnumake@/bin:@gcc@/bin:@gettext@/bin"
      , "export SHELL=@bash@/bin/bash"
      , "tar xzf @hello-src@"
      , "cd hello-2.12.1"
      , "./configure --prefix=$out"
      , "make"
      , "make install"
      ]
  toolchain =
    List.map
      unix.Dep.Nixpkgs
      [ "bash", "coreutils", "gnugrep", "gnused", "gawk", "gnutar"
      , "gzip", "gnumake", "gcc", "gettext"
      ]
  src =
    unix.Dep.Fetch
      "hello-src"
      "https://ftp.gnu.org/gnu/hello/hello-2.12.1.tar.gz"
      "sha256-jZkUKv2SV28wsM18tCqNxoCZmLxdYH2Idh9RLibH2yA="
  unix.Pkg.Pkg "hello-2.12.1" script (src +: toolchain)

-- The payoff of typed derivations: a nixpkgs override is a pure
-- function on a value. Rename, add a configure flag, drop the test
-- suite. The daemon rebuilds hello from source under the new
-- identity.
pkgs.uniHello.override : unix.Drv -> unix.Drv
pkgs.uniHello.override d =
  d
    |> unix.Drv.rename "hello-uni"
    |> unix.Drv.setAttr
         "configureFlags"
         (Json.array [Json.text "--program-prefix=uni-"])
    |> unix.Drv.setAttr "doCheck" (Json.Boolean false)
    |> unix.Drv.setAttr "doInstallCheck" (Json.Boolean false)

pkgs.registry : [(Text, unix.Pkg)]
pkgs.registry =
  [ ("greeting", pkgs.greeting)
  , ("banner", pkgs.banner)
  , ("shout", pkgs.shout)
  , ("hello", pkgs.gnuhello)
  ]

-- Packages whose build scripts are Unison, not bash. The script is
-- a first-class value over the Sh ability -- an inline lambda is
-- fine. realiseU ships the closure (value + code) to the sandbox;
-- a generic runner loads and runs it there.

pkgs.ugreeting : unix.UPkg
pkgs.ugreeting =
  unix.UPkg.UPkg
    "ugreeting"
    (do writeFileUtf8 (FilePath unix.Sh.out) "hello from a unison builder\n")
    []

-- GNU hello again, but the build script is Unison end to end.
pkgs.uhello : unix.UPkg
pkgs.uhello =
  script = do
    use unix.Sh run cd dep
    run "tar" ["xzf", dep "hello-src"]
    cd "hello-2.12.1"
    run "./configure" ["--prefix=" ++ unix.Sh.out]
    run "make" []
    run "make" ["install"]
  src =
    unix.Dep.Fetch
      "hello-src"
      "https://ftp.gnu.org/gnu/hello/hello-2.12.1.tar.gz"
      "sha256-jZkUKv2SV28wsM18tCqNxoCZmLxdYH2Idh9RLibH2yA="
  toolchain =
    List.map
      unix.Dep.Nixpkgs
      [ "bash", "coreutils", "gnugrep", "gnused", "gawk", "gnutar"
      , "gzip", "gnumake", "gcc", "gettext"
      ]
  unix.UPkg.UPkg "uhello-2.12.1" script (src +: toolchain)

pkgs.uregistry : [(Text, unix.UPkg)]
pkgs.uregistry = [("ugreeting", pkgs.ugreeting), ("uhello", pkgs.uhello)]

-- ----------------------------------------------------------------
-- Entry points.

unix.test.main : '{IO, Exception} ()
unix.test.main = do
  expectOut = "/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9"
  gotOut = unix.placeholder "out"
  expectUp = "/06vf5fh13wskpg2pr3wdh7r95xhyx1j9sp8y3qga3b1qlpbjpq49"
  gotUp =
    unix.upstreamPlaceholder
      "/nix/store/b9mn5w3x4p2mi9y5344pfykak46f71ys-dep-a.drv" "out"
  check = label -> expect -> got -> let
    if expect == (got : Text)
      then printLine (label ++ ": ok")
      else printLine (label ++ ": FAIL got " ++ got)
  check "own-output placeholder" expectOut gotOut
  check "upstream placeholder" expectUp gotUp

unix.main : '{IO, Exception} ()
unix.main = do
  match !IO.getArgs with
    ["index"] ->
      printLine
        ("evaluating " ++ Nat.toText (List.size unix.index.attrs)
          ++ " attrs in one nix eval ...")
      !unix.index.generate
      printLine "wrote src/nixpkgs-index.u"
    ["deep-hello"] ->
      (rootDrv, _, _) = unix.resolveNixpkgs "hello"
      printLine ("importing closure of " ++ rootDrv ++ " ...")
      closure = unix.importClosure rootDrv
      printLine ("  " ++ Nat.toText (List.size closure) ++ " derivations")
      targets =
        List.foldLeft
          (acc -> p -> match p with
            (b, d) ->
              n = unix.Drv.name d
              if (n Text.== "stdenv-linux")
                || (n Text.== "stdenv-linux-no-cc")
              then acc :+ b
              else acc)
          []
          closure
      printLine
        ("  targets: " ++ Nat.toText (List.size targets) ++ " stdenv drvs")
      marker = "echo '>>> hello from the unison graph rewrite <<<'"
      f = d -> let
        old =
          Optional.getOrElse "" (unix.assoc.lookup "preHook" (unix.Drv.env d))
        unix.Drv.setEnv "preHook" (old ++ "\n" ++ marker) d
      marks = unix.closure.markAll closure targets
      nAff =
        List.size (List.filter (p -> at2 p) marks)
      printLine ("  affected: " ++ Nat.toText nAff ++ " drvs to rewrite")
      (_, newRoot) =
        unix.closure.rewrite closure marks targets f []
          (Text.drop 11 rootDrv)
      printLine ("building " ++ newRoot ++ " ...")
      out =
        unix.nix
          ["build", "--no-link", "--print-out-paths", newRoot ++ "^out"]
          ""
      printLine ("out: " ++ unix.chomp out)
    ["uni-hello"] ->
      printLine "importing nixpkgs#hello ..."
      d = unix.importDrv "hello"
      d2 = unix.Drv.caify (pkgs.uniHello.override d)
      drv = unix.Drv.realise d2
      printLine ("  drv hello-uni -> " ++ drv)
      printLine ("building " ++ drv ++ " ...")
      out =
        unix.nix
          ["build", "--no-link", "--print-out-paths", drv ++ "^out"]
          ""
      printLine ("out: " ++ unix.chomp out)
    [pkgName] ->
      match unix.assoc.lookup pkgName pkgs.registry with
        Some pkg ->
          printLine ("realising " ++ pkgName ++ " ...")
          drv = unix.realise pkg
          printLine ("building " ++ drv ++ " ...")
          out =
            unix.nix
              ["build", "--no-link", "--print-out-paths", drv ++ "^out"]
              ""
          printLine ("out: " ++ unix.chomp out)
        None -> match unix.assoc.lookup pkgName pkgs.uregistry with
          Some up ->
            printLine ("realising " ++ pkgName ++ " (unison builder) ...")
            drv = unix.realiseU up
            printLine ("building " ++ drv ++ " ...")
            out =
              unix.nix
                ["build", "--no-link", "--print-out-paths", drv ++ "^out"]
                ""
            printLine ("out: " ++ unix.chomp out)
          None ->
            printLine
              ("unknown package: " ++ pkgName ++ " (known: "
                ++ Text.join
                    ", "
                    (List.map at1 pkgs.registry
                      ++ List.map at1 pkgs.uregistry)
                ++ ")")
    _ -> printLine "usage: unix <package>"
