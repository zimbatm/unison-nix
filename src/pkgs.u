-- pkgs: the demo package set and entry points, consuming the
-- upkg library (src/upkg.u) from the codebase.

-- ----------------------------------------------------------------
-- A tiny package set.

pkgs.greeting : upkg.Pkg
pkgs.greeting =
  upkg.Pkg.Pkg
    "greeting"
    "echo hello from the unison frontend > $out"
    []

pkgs.banner : upkg.Pkg
pkgs.banner =
  upkg.Pkg.Pkg
    "banner"
    "read -r line < @greeting@; { echo \"$line\"; echo this is nix without nixexpr; } > $out"
    [upkg.Dep.Local pkgs.greeting]

-- Uses real nixpkgs packages: hello from the binary cache, tr from
-- coreutils. Mixes a local CA dep (banner) with nixpkgs deps.
pkgs.shout : upkg.Pkg
pkgs.shout =
  upkg.Pkg.Pkg
    "shout"
    "{ @hello@/bin/hello; @coreutils@/bin/tr a-z A-Z < @banner@; } > $out"
    [ upkg.Dep.Nixpkgs "hello"
    , upkg.Dep.Nixpkgs "coreutils"
    , upkg.Dep.Local pkgs.banner
    ]

-- The milestone: compile GNU hello 2.12.1 from the upstream
-- tarball. nixpkgs ships 2.12.3, so this is not a replay -- the
-- source fetch and build are ours. Toolchain from nixpkgs.
pkgs.gnuhello : upkg.Pkg
pkgs.gnuhello =
  script =
    Text.join
      "\n"
      [ "set -e"
      , "export PATH=@bash@/bin:@coreutils@/bin:@gnugrep@/bin:@gnused@/bin:@gawk@/bin:@gnutar@/bin:@gzip@/bin:@gnumake@/bin:@gcc@/bin:@gettext@/bin"
      , "export SHELL=@bash@/bin/bash"
      , "tar xzf @hello-src@"
      , "cd hello-2.12.1"
      , "./configure --prefix=$out"
      , "make"
      , "make install"
      ]
  toolchain =
    List.map
      upkg.Dep.Nixpkgs
      [ "bash", "coreutils", "gnugrep", "gnused", "gawk", "gnutar"
      , "gzip", "gnumake", "gcc", "gettext"
      ]
  src =
    upkg.Dep.Fetch
      "hello-src"
      "https://ftp.gnu.org/gnu/hello/hello-2.12.1.tar.gz"
      "sha256-jZkUKv2SV28wsM18tCqNxoCZmLxdYH2Idh9RLibH2yA="
  upkg.Pkg.Pkg "hello-2.12.1" script (src +: toolchain)

-- The payoff of typed derivations: a nixpkgs override is a pure
-- function on a value. Rename, add a configure flag, drop the test
-- suite. The daemon rebuilds hello from source under the new
-- identity.
pkgs.uniHello.override : upkg.Drv -> upkg.Drv
pkgs.uniHello.override d =
  d
    |> upkg.Drv.rename "hello-uni"
    |> upkg.Drv.setAttr
         "configureFlags"
         (Json.array [Json.text "--program-prefix=uni-"])
    |> upkg.Drv.setAttr "doCheck" (Json.Boolean false)
    |> upkg.Drv.setAttr "doInstallCheck" (Json.Boolean false)

pkgs.registry : [(Text, upkg.Pkg)]
pkgs.registry =
  [ ("greeting", pkgs.greeting)
  , ("banner", pkgs.banner)
  , ("shout", pkgs.shout)
  , ("hello", pkgs.gnuhello)
  ]

-- Packages whose build scripts are Unison, not bash. The script is
-- a first-class value over the Sh ability -- an inline lambda is
-- fine. realiseU ships the closure (value + code) to the sandbox;
-- a generic runner loads and runs it there.

pkgs.ugreeting : upkg.UPkg
pkgs.ugreeting =
  upkg.UPkg.UPkg
    "ugreeting"
    (do writeFileUtf8 (FilePath upkg.Sh.out) "hello from a unison builder\n")
    []

-- GNU hello again, but the build script is Unison end to end.
pkgs.uhello : upkg.UPkg
pkgs.uhello =
  script = do
    use upkg.Sh run cd dep
    run "tar" ["xzf", dep "hello-src"]
    cd "hello-2.12.1"
    run "./configure" ["--prefix=" ++ upkg.Sh.out]
    run "make" []
    run "make" ["install"]
  src =
    upkg.Dep.Fetch
      "hello-src"
      "https://ftp.gnu.org/gnu/hello/hello-2.12.1.tar.gz"
      "sha256-jZkUKv2SV28wsM18tCqNxoCZmLxdYH2Idh9RLibH2yA="
  toolchain =
    List.map
      upkg.Dep.Nixpkgs
      [ "bash", "coreutils", "gnugrep", "gnused", "gawk", "gnutar"
      , "gzip", "gnumake", "gcc", "gettext"
      ]
  upkg.UPkg.UPkg "uhello-2.12.1" script (src +: toolchain)

-- ----------------------------------------------------------------
-- Configuration across stages: one typed record steers the dep
-- graph at eval time, renders nginx.conf at build time (the
-- renderer ships with the closure), and prints from the run-time
-- wrapper. What nixpkgs does with module options -> conf strings
-- -> wrappers is one value here.

-- A run-time secret is a reference, never a value: it names where
-- the wrapper finds the secret at startup. It cannot end up in the
-- store because the frontend never sees it. The stage each field
-- binds at is visible in its type: Nat and Boolean bake at build
-- time, Secret defers to run time.
type upkg.Secret = FromEnv Text | FromFile Text

type upkg.NginxConfig =
  { port : Nat
  , workers : Nat
  , gzip : Boolean
  , content : upkg.Pkg
  , auth : Optional (Text, upkg.Secret)
  }

-- Pure conf renderer. Runs inside the sandbox as shipped code.
upkg.nginx.conf : Nat -> Nat -> Boolean -> Boolean -> Text -> Text
upkg.nginx.conf port workers gzip authOn root =
  Text.join
    "\n"
    [ "daemon off;"
    , "worker_processes " ++ Nat.toText workers ++ ";"
    , "error_log stderr;"
    , "pid /tmp/nginx-unison.pid;"
    , "events { worker_connections 128; }"
    , "http {"
    , "  access_log off;"
    , "  default_type text/html;"
    , "  client_body_temp_path /tmp/nginx-unison-body;"
    , "  proxy_temp_path /tmp/nginx-unison-proxy;"
    , "  fastcgi_temp_path /tmp/nginx-unison-fcgi;"
    , "  uwsgi_temp_path /tmp/nginx-unison-uwsgi;"
    , "  scgi_temp_path /tmp/nginx-unison-scgi;"
    , "  " ++ (if gzip then "gzip on;" else "gzip off;")
    , "  server {"
    , "    listen 127.0.0.1:" ++ Nat.toText port ++ ";"
    , "    root " ++ root ++ ";"
    , "    index index.html;"
    , if authOn then
        Text.join
          "\n"
          [ "    auth_basic \"unison\";"
          , "    auth_basic_user_file /tmp/nginx-unison-htpasswd;"
          ]
      else "    # no auth"
    , "  }"
    , "}"
    , ""
    ]

upkg.mkNginx : upkg.NginxConfig -> upkg.UPkg
upkg.mkNginx cfg =
  -- Destructure before the lambda: the closure captures these
  -- scalars, not the whole record (which drags the content Pkg).
  port = upkg.NginxConfig.port cfg
  workers = upkg.NginxConfig.workers cfg
  gzip = upkg.NginxConfig.gzip cfg
  contentName = upkg.Pkg.name (upkg.NginxConfig.content cfg)
  -- The wrapper preamble that resolves the secret at run time.
  -- Only shell text is captured; the secret itself never exists
  -- at eval or build time.
  authPre = match upkg.NginxConfig.auth cfg with
    None -> []
    Some (user, upkg.Secret.FromEnv var) ->
      [ ": \"${" ++ var ++ ":?set " ++ var
          ++ " to the basic auth password}\""
      , "umask 077"
      , "printf '%s:{PLAIN}%s\\n' '" ++ user ++ "' \"$" ++ var
          ++ "\" > /tmp/nginx-unison-htpasswd"
      ]
    Some (user, upkg.Secret.FromFile path) ->
      [ "umask 077"
      , "printf '%s:{PLAIN}%s\\n' '" ++ user ++ "' \"$(cat " ++ path
          ++ ")\" > /tmp/nginx-unison-htpasswd"
      ]
  authOn = Boolean.not (List.isEmpty authPre)
  script = do
    use upkg.Sh run dep
    out = upkg.Sh.out
    html = out ++ "/html"
    run "mkdir" ["-p", html, out ++ "/bin"]
    run "cp" [dep contentName, html ++ "/index.html"]
    writeFileUtf8
      (FilePath (out ++ "/nginx.conf"))
      (upkg.nginx.conf port workers gzip authOn html)
    writeFileUtf8
      (FilePath (out ++ "/bin/serve"))
      (Text.join
        "\n"
        ([ "#!/bin/sh"
         , "echo 'serving " ++ contentName ++ " on http://127.0.0.1:"
             ++ Nat.toText port ++ "' >&2"
         ]
          ++ authPre
          ++ [ "exec " ++ dep "nginx" ++ "/bin/nginx -e stderr -c " ++ out
                 ++ "/nginx.conf"
             , ""
             ]))
    run "chmod" ["+x", out ++ "/bin/serve"]
  upkg.UPkg.UPkg
    ("nginx-" ++ contentName)
    script
    [ upkg.Dep.Nixpkgs "nginx"
    , upkg.Dep.Nixpkgs "coreutils"
    , upkg.Dep.Local (upkg.NginxConfig.content cfg)
    ]

-- The instance: serve the banner built by our own frontend, with
-- basic auth whose password arrives at run time via $NGINX_PASSWORD.
pkgs.unginx : upkg.UPkg
pkgs.unginx =
  upkg.mkNginx
    (upkg.NginxConfig.NginxConfig
      8080
      2
      true
      pkgs.banner
      (Some ("admin", upkg.Secret.FromEnv "NGINX_PASSWORD")))

-- ----------------------------------------------------------------
-- The quine: upkg packaged by upkg. The build script is a shipped
-- closure that references pkgs.dispatch, so the whole frontend --
-- pinned index included -- rides along in the envelope. The same
-- closure has two modes: run by the sandbox with no extra args it
-- installs a copy of its own envelope (found via
-- /proc/self/cmdline) and a wrapper; run from the store with args,
-- it IS the package manager.

pkgs.self.script : '{IO, Exception, upkg.Sh} ()
pkgs.self.script = do
  match List.drop 1 !IO.getArgs with
    [] ->
      use upkg.Sh run
      out = upkg.Sh.out
      nul = Optional.getOrElse ?a (Char.fromNat 0)
      -- /proc/self in a child is the child; $PPID gets the runner
      run "/bin/sh" ["-c", "cp /proc/$PPID/cmdline self-cmdline"]
      argv =
        List.filter
          (t -> Nat.gt (Text.size t) 0)
          (Text.split nul (readFileUtf8 (FilePath "self-cmdline")))
      ucmPath = upkg.Sh.dep "unison-ucm" ++ "/bin/ucm"
      match List.reverse argv with
        uvPath +: (runnerPath +: _) ->
          run "mkdir" ["-p", out ++ "/bin", out ++ "/lib"]
          run "cp" [uvPath, out ++ "/lib/upkg.uv"]
          writeFileUtf8
            (FilePath (out ++ "/bin/upkg"))
            (Text.join
              "\n"
              [ "#!/bin/sh"
              , "exec " ++ ucmPath ++ " run.compiled " ++ runnerPath
                  ++ " " ++ out ++ "/lib/upkg.uv \"$@\""
              , ""
              ])
          run "chmod" ["+x", out ++ "/bin/upkg"]
        _ ->
          Exception.raise
            (Generic.failure
              ("self: unexpected /proc/self/cmdline: "
                ++ Text.join " | " argv)
              ())
    args -> pkgs.dispatch args

pkgs.self : upkg.UPkg
pkgs.self =
  upkg.UPkg.UPkg
    "upkg"
    pkgs.self.script
    [upkg.Dep.Nixpkgs "coreutils", upkg.Dep.Nixpkgs "unison-ucm"]

pkgs.uregistry : [(Text, upkg.UPkg)]
pkgs.uregistry =
  [ ("ugreeting", pkgs.ugreeting)
  , ("uhello", pkgs.uhello)
  , ("nginx", pkgs.unginx)
  ]

-- ----------------------------------------------------------------
-- Entry points.

pkgs.test.main : '{IO, Exception} ()
pkgs.test.main = do
  expectOut = "/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9"
  gotOut = upkg.placeholder "out"
  expectUp = "/06vf5fh13wskpg2pr3wdh7r95xhyx1j9sp8y3qga3b1qlpbjpq49"
  gotUp =
    upkg.upstreamPlaceholder
      "/nix/store/b9mn5w3x4p2mi9y5344pfykak46f71ys-dep-a.drv" "out"
  check = label -> expect -> got -> let
    if expect == (got : Text)
      then printLine (label ++ ": ok")
      else printLine (label ++ ": FAIL got " ++ got)
  check "own-output placeholder" expectOut gotOut
  check "upstream placeholder" expectUp gotUp

pkgs.dispatch : [Text] -> {IO, Exception} ()
pkgs.dispatch args =
  match args with
    ["index"] ->
      printLine
        ("evaluating " ++ Nat.toText (List.size upkg.index.attrs)
          ++ " attrs in one nix eval ...")
      !upkg.index.generate
      printLine "wrote src/nixpkgs-index.u"
    ["deep-hello"] ->
      rootDrv = upkg.Pinned.drv (upkg.resolveNixpkgs "hello")
      printLine ("importing closure of " ++ rootDrv ++ " ...")
      closure = upkg.importClosure rootDrv
      printLine ("  " ++ Nat.toText (Map.size closure) ++ " derivations")
      targets =
        List.foldLeft
          (acc -> cases (b, d) ->
            n = upkg.Drv.name d
            if (n Text.== "stdenv-linux")
              || (n Text.== "stdenv-linux-no-cc")
            then Set.insert b acc
            else acc)
          Set.empty
          (Map.toList closure)
      printLine
        ("  targets: " ++ Nat.toText (Set.size targets) ++ " stdenv drvs")
      marker = "echo '>>> hello from the unison graph rewrite <<<'"
      f = d -> let
        old =
          Optional.getOrElse "" (upkg.assoc.lookup "preHook" (upkg.Drv.env d))
        upkg.Drv.setEnv "preHook" (old ++ "\n" ++ marker) d
      marks = upkg.closure.markAll closure targets
      nAff = List.size (List.filter at2 (Map.toList marks))
      printLine ("  affected: " ++ Nat.toText nAff ++ " drvs to rewrite")
      (_, newRoot) =
        upkg.closure.rewrite closure marks targets f Map.empty
          (Text.drop 11 rootDrv)
      printLine ("building " ++ newRoot ++ " ...")
      out =
        upkg.nix
          ["build", "--no-link", "--print-out-paths", newRoot ++ "^out"]
          ""
      printLine ("out: " ++ upkg.chomp out)
    ["upkg"] ->
      printLine "realising upkg (the quine) ..."
      drv = upkg.realiseU pkgs.self
      printLine ("building " ++ drv ++ " ...")
      out =
        upkg.nix
          ["build", "--no-link", "--print-out-paths", drv ++ "^out"]
          ""
      printLine ("out: " ++ upkg.chomp out)
    ["hexyl"] ->
      lock = readFileUtf8 (FilePath "fixtures/hexyl-0.16.0.Cargo.lock")
      up =
        upkg.cargo.pkg
          "hexyl"
          "0.16.0"
          "sha256-Q9Vt0EhytsbUKfGNLgPflfhT/rYYx82L8i0OaFHOXvg="
          lock
      printLine "realising hexyl (cargo, unison builder) ..."
      drv = upkg.realiseU up
      printLine ("building " ++ drv ++ " ...")
      out =
        upkg.nix
          ["build", "--no-link", "--print-out-paths", drv ++ "^out"]
          ""
      printLine ("out: " ++ upkg.chomp out)
    ["uni-hello"] ->
      printLine "importing nixpkgs#hello ..."
      d = upkg.importDrv "hello"
      d2 = upkg.Drv.caify (pkgs.uniHello.override d)
      drv = upkg.Drv.realise d2
      printLine ("  drv hello-uni -> " ++ drv)
      printLine ("building " ++ drv ++ " ...")
      out =
        upkg.nix
          ["build", "--no-link", "--print-out-paths", drv ++ "^out"]
          ""
      printLine ("out: " ++ upkg.chomp out)
    [pkgName] ->
      match upkg.assoc.lookup pkgName pkgs.registry with
        Some pkg ->
          printLine ("realising " ++ pkgName ++ " ...")
          drv = upkg.realise pkg
          printLine ("building " ++ drv ++ " ...")
          out =
            upkg.nix
              ["build", "--no-link", "--print-out-paths", drv ++ "^out"]
              ""
          printLine ("out: " ++ upkg.chomp out)
        None -> match upkg.assoc.lookup pkgName pkgs.uregistry with
          Some up ->
            printLine ("realising " ++ pkgName ++ " (unison builder) ...")
            drv = upkg.realiseU up
            printLine ("building " ++ drv ++ " ...")
            out =
              upkg.nix
                ["build", "--no-link", "--print-out-paths", drv ++ "^out"]
                ""
            printLine ("out: " ++ upkg.chomp out)
          None ->
            printLine
              ("unknown package: " ++ pkgName ++ " (known: "
                ++ Text.join
                    ", "
                    (List.map at1 pkgs.registry
                      ++ List.map at1 pkgs.uregistry)
                ++ ")")
    _ -> printLine "usage: upkg <package>"

pkgs.main : '{IO, Exception} ()
pkgs.main = do pkgs.dispatch !IO.getArgs
