-- pkgs: the demo package set and entry points, consuming the
-- upkg library (src/upkg.u) from the codebase.

-- ----------------------------------------------------------------
-- A tiny package set.

pkgs.greeting : upkg.Pkg
pkgs.greeting =
  upkg.Pkg.Pkg
    "greeting"
    "echo hello from the unison frontend > $out"
    []

pkgs.banner : upkg.Pkg
pkgs.banner =
  upkg.Pkg.Pkg
    "banner"
    "read -r line < @greeting@; { echo \"$line\"; echo this is nix without nixexpr; } > $out"
    [upkg.Dep.Local pkgs.greeting]

-- Uses real nixpkgs packages: hello from the binary cache, tr from
-- coreutils. Mixes a local CA dep (banner) with nixpkgs deps.
pkgs.shout : upkg.Pkg
pkgs.shout =
  upkg.Pkg.Pkg
    "shout"
    "{ @hello@/bin/hello; @coreutils@/bin/tr a-z A-Z < @banner@; } > $out"
    [ upkg.Dep.Nixpkgs "hello"
    , upkg.Dep.Nixpkgs "coreutils"
    , upkg.Dep.Local pkgs.banner
    ]

-- The milestone: compile GNU hello 2.12.1 from the upstream
-- tarball. nixpkgs ships 2.12.3, so this is not a replay -- the
-- source fetch and build are ours. Toolchain from nixpkgs.
pkgs.gnuhello : upkg.Pkg
pkgs.gnuhello =
  script =
    Text.join
      "\n"
      [ "set -e"
      , "export PATH=@bash@/bin:@coreutils@/bin:@gnugrep@/bin:@gnused@/bin:@gawk@/bin:@gnutar@/bin:@gzip@/bin:@gnumake@/bin:@gcc@/bin:@gettext@/bin"
      , "export SHELL=@bash@/bin/bash"
      , "tar xzf @hello-src@"
      , "cd hello-2.12.1"
      , "./configure --prefix=$out"
      , "make"
      , "make install"
      ]
  toolchain =
    List.map
      upkg.Dep.Nixpkgs
      [ "bash", "coreutils", "gnugrep", "gnused", "gawk", "gnutar"
      , "gzip", "gnumake", "gcc", "gettext"
      ]
  src =
    upkg.Dep.Fetch
      "hello-src"
      "https://ftp.gnu.org/gnu/hello/hello-2.12.1.tar.gz"
      "sha256-jZkUKv2SV28wsM18tCqNxoCZmLxdYH2Idh9RLibH2yA="
  upkg.Pkg.Pkg "hello-2.12.1" script (src +: toolchain)

-- The payoff of typed derivations: a nixpkgs override is a pure
-- function on a value. Rename, add a configure flag, drop the test
-- suite. The daemon rebuilds hello from source under the new
-- identity.
pkgs.uniHello.override : upkg.Drv -> upkg.Drv
pkgs.uniHello.override d =
  d
    |> upkg.Drv.rename "hello-uni"
    |> upkg.Drv.setAttr
         "configureFlags"
         (Json.array [Json.text "--program-prefix=uni-"])
    |> upkg.Drv.setAttr "doCheck" (Json.Boolean false)
    |> upkg.Drv.setAttr "doInstallCheck" (Json.Boolean false)

pkgs.registry : [(Text, upkg.Pkg)]
pkgs.registry =
  [ ("greeting", pkgs.greeting)
  , ("banner", pkgs.banner)
  , ("shout", pkgs.shout)
  , ("hello", pkgs.gnuhello)
  ]

-- Packages whose build scripts are Unison, not bash. The script is
-- a first-class value over the Sh ability -- an inline lambda is
-- fine. realiseU ships the closure (value + code) to the sandbox;
-- a generic runner loads and runs it there.

pkgs.ugreeting : upkg.UPkg
pkgs.ugreeting =
  upkg.UPkg.UPkg
    "ugreeting"
    (do writeFileUtf8 (FilePath upkg.Sh.out) "hello from a unison builder\n")
    []

-- GNU hello again, but the build script is Unison end to end.
pkgs.uhello : upkg.UPkg
pkgs.uhello =
  script = do
    use upkg.Sh run cd dep
    run "tar" ["xzf", dep "hello-src"]
    cd "hello-2.12.1"
    run "./configure" ["--prefix=" ++ upkg.Sh.out]
    run "make" []
    run "make" ["install"]
  src =
    upkg.Dep.Fetch
      "hello-src"
      "https://ftp.gnu.org/gnu/hello/hello-2.12.1.tar.gz"
      "sha256-jZkUKv2SV28wsM18tCqNxoCZmLxdYH2Idh9RLibH2yA="
  toolchain =
    List.map
      upkg.Dep.Nixpkgs
      [ "bash", "coreutils", "gnugrep", "gnused", "gawk", "gnutar"
      , "gzip", "gnumake", "gcc", "gettext"
      ]
  upkg.UPkg.UPkg "uhello-2.12.1" script (src +: toolchain)

-- ----------------------------------------------------------------
-- Configuration across stages: one typed record steers the dep
-- graph at eval time, renders nginx.conf at build time (the
-- renderer ships with the closure), and prints from the run-time
-- wrapper. What nixpkgs does with module options -> conf strings
-- -> wrappers is one value here.

-- A run-time secret is a reference, never a value: it names where
-- the wrapper finds the secret at startup. It cannot end up in the
-- store because the frontend never sees it. The stage each field
-- binds at is visible in its type: Nat and Boolean bake at build
-- time, Secret defers to run time.
type pkgs.Secret = FromEnv Text | FromFile Text

type pkgs.NginxConfig =
  { port : Nat
  , workers : Nat
  , gzip : Boolean
  , content : upkg.Pkg
  , auth : Optional (Text, pkgs.Secret)
  }

-- Pure conf renderer. Runs inside the sandbox as shipped code.
pkgs.nginx.conf : Nat -> Nat -> Boolean -> Boolean -> Text -> Text
pkgs.nginx.conf port workers gzip authOn root =
  Text.join
    "\n"
    [ "daemon off;"
    , "worker_processes " ++ Nat.toText workers ++ ";"
    , "error_log stderr;"
    , "pid /tmp/nginx-unison.pid;"
    , "events { worker_connections 128; }"
    , "http {"
    , "  access_log off;"
    , "  default_type text/html;"
    , "  client_body_temp_path /tmp/nginx-unison-body;"
    , "  proxy_temp_path /tmp/nginx-unison-proxy;"
    , "  fastcgi_temp_path /tmp/nginx-unison-fcgi;"
    , "  uwsgi_temp_path /tmp/nginx-unison-uwsgi;"
    , "  scgi_temp_path /tmp/nginx-unison-scgi;"
    , "  " ++ (if gzip then "gzip on;" else "gzip off;")
    , "  server {"
    , "    listen 127.0.0.1:" ++ Nat.toText port ++ ";"
    , "    root " ++ root ++ ";"
    , "    index index.html;"
    , if authOn then
        Text.join
          "\n"
          [ "    auth_basic \"unison\";"
          , "    auth_basic_user_file /tmp/nginx-unison-htpasswd;"
          ]
      else "    # no auth"
    , "  }"
    , "}"
    , ""
    ]

pkgs.mkNginx : pkgs.NginxConfig -> upkg.UPkg
pkgs.mkNginx cfg =
  -- Destructure before the lambda: the closure captures these
  -- scalars, not the whole record (which drags the content Pkg).
  port = pkgs.NginxConfig.port cfg
  workers = pkgs.NginxConfig.workers cfg
  gzip = pkgs.NginxConfig.gzip cfg
  contentName = upkg.Pkg.name (pkgs.NginxConfig.content cfg)
  -- The wrapper preamble that resolves the secret at run time.
  -- Only shell text is captured; the secret itself never exists
  -- at eval or build time.
  authPre = match pkgs.NginxConfig.auth cfg with
    None -> []
    Some (user, pkgs.Secret.FromEnv var) ->
      [ ": \"${" ++ var ++ ":?set " ++ var
          ++ " to the basic auth password}\""
      , "umask 077"
      , "printf '%s:{PLAIN}%s\\n' '" ++ user ++ "' \"$" ++ var
          ++ "\" > /tmp/nginx-unison-htpasswd"
      ]
    Some (user, pkgs.Secret.FromFile path) ->
      [ "umask 077"
      , "printf '%s:{PLAIN}%s\\n' '" ++ user ++ "' \"$(cat " ++ path
          ++ ")\" > /tmp/nginx-unison-htpasswd"
      ]
  authOn = Boolean.not (List.isEmpty authPre)
  script = do
    use upkg.Sh run dep
    out = upkg.Sh.out
    html = out ++ "/html"
    run "mkdir" ["-p", html, out ++ "/bin"]
    run "cp" [dep contentName, html ++ "/index.html"]
    writeFileUtf8
      (FilePath (out ++ "/nginx.conf"))
      (pkgs.nginx.conf port workers gzip authOn html)
    writeFileUtf8
      (FilePath (out ++ "/bin/serve"))
      (Text.join
        "\n"
        ([ "#!/bin/sh"
         , "echo 'serving " ++ contentName ++ " on http://127.0.0.1:"
             ++ Nat.toText port ++ "' >&2"
         ]
          ++ authPre
          ++ [ "exec " ++ dep "nginx" ++ "/bin/nginx -e stderr -c " ++ out
                 ++ "/nginx.conf"
             , ""
             ]))
    run "chmod" ["+x", out ++ "/bin/serve"]
  upkg.UPkg.UPkg
    ("nginx-" ++ contentName)
    script
    [ upkg.Dep.Nixpkgs "nginx"
    , upkg.Dep.Nixpkgs "coreutils"
    , upkg.Dep.Local (pkgs.NginxConfig.content cfg)
    ]

pkgs.uregistry : [(Text, upkg.UPkg)]
pkgs.uregistry =
  [ ("ugreeting", pkgs.ugreeting)
  , ("uhello", pkgs.uhello)
  ]
