-- upkg: Unison as a frontend to Nix.
--
-- Packages are plain Unison values. We compute Nix derivations as
-- JSON, feed them to `nix derivation add`, and build the returned
-- .drv path with `nix build`. The Nix expression language is never
-- involved.
--
-- All outputs are floating content-addressed (ca-derivations). The
-- daemon computes output paths, so we never implement Nix's store
-- path hashing. We only need two placeholder hashes, verified
-- against Nix 2.35:
--   own output:  nixbase32(sha256("nix-output:<output>"))
--   dep output:  nixbase32(sha256("nix-upstream-output:<drvhash>:<name>"))

-- ----------------------------------------------------------------
-- Nix base32. Not RFC 4648: custom alphabet, bits read in reverse.

upkg.base32.alphabet : [Char]
upkg.base32.alphabet = Text.toCharList "0123456789abcdfghijklmnpqrsvwxyz"

upkg.base32.encode : Bytes -> Text
upkg.base32.encode bs =
  n = Bytes.size bs
  byte = j -> Optional.getOrElse 0 (Bytes.at j bs)
  len = Nat.diff (n * 8) 1 / 5 + 1
  charFor = i -> let
    b = i * 5
    j = b / 8
    bit = mod b 8
    hi = if j + 1 < n then Nat.shiftLeft (byte (j + 1)) (Nat.diff 8 bit) else 0
    c = Nat.and (Nat.or (Nat.shiftRight (byte j) bit) hi) 31
    Optional.getOrElse ?0 (List.at c upkg.base32.alphabet)
  List.range 0 len
    |> List.map charFor
    |> List.reverse
    |> Text.fromCharList

upkg.sha256 : Text -> Bytes
upkg.sha256 t =
  crypto.hashBytes crypto.HashAlgorithm.Sha2_256 (Text.toUtf8 t)

-- Placeholder for one of our own outputs ($out in build scripts).
upkg.placeholder : Text -> Text
upkg.placeholder output =
  "/" ++ upkg.base32.encode (upkg.sha256 ("nix-output:" ++ output))

-- Placeholder for the output of a dependency .drv. Nix rewrites it
-- to the real store path once the dependency is built.
upkg.upstreamPlaceholder : Text -> Text -> Text
upkg.upstreamPlaceholder drvPath output =
  hashPart = Text.take 32 (Text.drop 11 drvPath)
  base = Text.drop 44 drvPath
  drvName = Text.take (Nat.diff (Text.size base) 4) base
  refName = if output == "out" then drvName else drvName ++ "-" ++ output
  "/" ++ upkg.base32.encode
    (upkg.sha256 ("nix-upstream-output:" ++ hashPart ++ ":" ++ refName))

-- ----------------------------------------------------------------
-- The package model. This is the whole "language": a package is a
-- name, a shell script, and dependencies. A dependency is either
-- another Pkg or a nixpkgs attribute. Scripts refer to a
-- dependency's output as @depname@ / @attr@.
--
-- Nixpkgs deps work because their derivations are input-addressed:
-- output paths are fixed at eval time, so we splice the literal
-- store path and list the .drv in inputs. No placeholder needed.

-- Fetch is name, url, SRI hash. It becomes a fixed-output
-- derivation: the sandbox gets network, the daemon checks the hash.

type upkg.Dep = Local upkg.Pkg | Nixpkgs Text | Fetch Text Text Text

type upkg.Pkg = { name : Text, script : Text, deps : [upkg.Dep] }

upkg.system : Text
upkg.system = "x86_64-linux"

-- Output sections. Floating CA: the daemon computes the path.
-- Fixed: we give the SRI hash of the file, the daemon derives the
-- path from it.

upkg.caOutputs : Json
upkg.caOutputs =
  Json.object
    [ ( "out"
      , Json.object
          [ ("hashAlgo", Json.text "sha256")
          , ("method", Json.text "nar")
          ]
      )
    ]

upkg.fixedOutputs : Text -> Json
upkg.fixedOutputs sri =
  Json.object
    [ ( "out"
      , Json.object [("hash", Json.text sri), ("method", Json.text "flat")]
      )
    ]

-- Group (drvPath, outputName) pairs by drvPath so the same .drv
-- never appears twice in inputs.drvs.
upkg.groupDeps : [(Text, Text)] -> [(Text, [Text])]
upkg.groupDeps ps =
  union : [Text] -> [Text] -> [Text]
  union = xs -> ys -> let
    List.foldLeft
      (acc -> o -> if List.any (o2 -> o2 Text.== o) acc then acc else acc :+ o)
      xs
      ys
  add = m -> cases (drvPath, outName) ->
    Map.putWith union drvPath [outName] m
  Map.toList (List.foldLeft add Map.empty ps)

-- With structured attrs the daemon does not export env vars. The
-- builder reads .attrs.sh instead. This prelude defines $out (and
-- any future outputs) for the package script. Needs bash: .attrs.sh
-- uses declare -A, which busybox sh cannot parse.
upkg.attrsPrelude : Text
upkg.attrsPrelude =
  Text.join
    "\n"
    [ ". \"$NIX_ATTRS_SH_FILE\""
    , "for o in \"${!outputs[@]}\"; do export \"$o=${outputs[$o]}\"; done"
    , ""
    ]

-- Derivation JSON, schema version 4 (Nix 2.35). Structured attrs
-- out of the box: env carries only the output paths, everything
-- else lives in structuredAttrs / the .attrs files. Deps are
-- (drvPath, outputName) pairs. outEnv is $out as stored in env: a
-- floating-CA placeholder, or "" for fixed outputs -- the daemon
-- replaces "" with the computed path on `derivation add`.
upkg.drvJson' : Text -> Text -> Text -> [(Text, Text)] -> Text -> Json -> Text
upkg.drvJson' name builder script depDrvs outEnv outputsJson =
  inputDrv = cases
    (drvPath, outNames) ->
      ( Text.drop 11 drvPath
      , Json.object
          [ ("dynamicOutputs", Json.object [])
          , ("outputs", Json.array (List.map Json.text outNames))
          ]
      )
  Json.toText
    (Json.object
      [ ( "args"
        , Json.array
            [Json.text "-c", Json.text (upkg.attrsPrelude ++ script)]
        )
      , ("builder", Json.text builder)
      , ("env", Json.object [("out", Json.text outEnv)])
      , ( "inputs"
        , Json.object
            [ ( "drvs"
              , Json.object (List.map inputDrv (upkg.groupDeps depDrvs))
              )
            , ("srcs", Json.array [])
            ]
        )
      , ("name", Json.text name)
      , ("outputs", outputsJson)
      , ( "structuredAttrs"
        , Json.object
            [ ("builder", Json.text builder)
            , ("name", Json.text name)
            , ("outputs", Json.array [Json.text "out"])
            , ("system", Json.text upkg.system)
            ]
        )
      , ("system", Json.text upkg.system)
      , ("version", Json.nat 4)
      ])

upkg.drvJson : Text -> Text -> Text -> [(Text, Text)] -> Text
upkg.drvJson name builder script depDrvs =
  upkg.drvJson' name builder script depDrvs (upkg.placeholder "out")
    upkg.caOutputs

-- ----------------------------------------------------------------
-- Talking to Nix.

upkg.exec : Text -> [Text] -> Text -> {IO, Exception} Text
upkg.exec cmd args input =
  (stdin, stdout, stderr, proc) = IO.Process.start cmd args
  Handle.putText stdin input
  Handle.close stdin
  out = Handle.getText stdout
  err = Handle.getText stderr
  code = IO.Process.wait proc
  match code with
    0 -> out
    _ ->
      Exception.raise
        (Generic.failure
          ("exec failed (" ++ Nat.toText code ++ "): " ++ cmd ++ " "
            ++ Text.join " " args ++ "\n" ++ err)
          ())

upkg.nix : [Text] -> Text -> {IO, Exception} Text
upkg.nix args input =
  upkg.exec
    "nix"
    (["--extra-experimental-features", "nix-command ca-derivations"] ++ args)
    input

upkg.chomp : Text -> Text
upkg.chomp = Text.replaceAll "\n" ""

upkg.addDrv : Text -> {IO, Exception} Text
upkg.addDrv j = upkg.chomp (upkg.nix ["derivation", "add"] j)

-- Ask the Nix evaluator for one nixpkgs attribute. One call returns
-- drv path, output path, and output name. Forcing drvPath also
-- writes the .drv into the store. The Nix language runs here, but
-- only as an importer -- like `guix import`.
upkg.evalNixpkgs : Text -> {IO, Exception} upkg.Pinned
upkg.evalNixpkgs attr =
  out =
    upkg.nix
      [ "eval", "--raw", "nixpkgs#" ++ attr
      , "--apply", "p: \"${p.drvPath}\\n${p.outPath}\\n${p.outputName}\""
      ]
      ""
  match Text.split ?\n out with
    [drvPath, outPath, outName] -> upkg.Pinned.Pinned drvPath outPath outName
    _ ->
      Exception.raise
        (Generic.failure ("unexpected eval output for " ++ attr) ())

-- ----------------------------------------------------------------
-- The pinned index. `nixpkgs.index` lives in the ucm codebase (see
-- src/nixpkgs-index.u, regenerated by `./run.sh index`). One batch
-- eval per nixpkgs revision; after that, resolving an attr is a
-- pure lookup plus a file-exists check. The Nix evaluator only
-- runs on an index miss, or when the .drv was garbage-collected.

-- A pinned nixpkgs attribute: drv path, default output path and
-- its name, all fixed at pin time.
type upkg.Pinned = { drv : Text, out : Text, output : Text }

upkg.index.lookup : Text -> Optional upkg.Pinned
upkg.index.lookup attr =
  List.findMap
    (cases (a, d, o, n) ->
      if a == attr then Some (upkg.Pinned.Pinned d o n) else None)
    nixpkgs.index

upkg.resolveNixpkgs : Text -> {IO, Exception} upkg.Pinned
upkg.resolveNixpkgs attr =
  hit = match upkg.index.lookup attr with
    Some p ->
      if FilePath.exists (FilePath (upkg.Pinned.drv p)) then Some p
      else None
    None -> None
  match hit with
    Some p -> p
    None ->
      printLine ("  eval " ++ attr ++ " (index miss)")
      upkg.evalNixpkgs attr

-- Attrs the demo package set needs. `./run.sh index` evaluates all
-- of them in a single nix eval call.
upkg.index.attrs : [Text]
upkg.index.attrs =
  [ "bash", "cacert", "cargo", "coreutils", "curl", "gawk", "gcc"
  , "gettext", "gnugrep", "gnumake", "gnused", "gnutar", "gzip"
  , "hello", "nginx", "rustc", "unison-ucm"
  ]

upkg.index.generate : '{IO, Exception} ()
upkg.index.generate = do
  meta = Json.fromText (upkg.nix ["flake", "metadata", "nixpkgs", "--json"] "")
  rev =
    upkg.json.asText
      (upkg.json.get "narHash" (upkg.json.get "locked" meta))
  quoted = Text.join " " (List.map (a -> "\"" ++ a ++ "\"") upkg.index.attrs)
  expr =
    "pkgs: builtins.concatStringsSep \"\\n\" (map (a: let p = pkgs.${a}; in \"${a}|${p.drvPath}|${p.outPath}|${p.outputName}\") [ "
      ++ quoted ++ " ])"
  out =
    upkg.nix
      [ "eval", "--raw", "nixpkgs#legacyPackages." ++ upkg.system
      , "--apply", expr
      ]
      ""
  entry = l -> match Text.split ?| l with
    [a, d, o, n] ->
      "(\"" ++ a ++ "\", \"" ++ d ++ "\", \"" ++ o ++ "\", \"" ++ n ++ "\")"
    _ ->
      Exception.raise (Generic.failure ("bad index line: " ++ l) ())
  tuples = List.map entry (Text.split ?\n out)
  body = match tuples with
    [] -> "  []"
    first +: rest ->
      "  [ " ++ first
        ++ Text.join "" (List.map (t -> "\n  , " ++ t) rest)
        ++ "\n  ]"
  txt =
    Text.join
      "\n"
      [ "-- Generated by ./run.sh index. Do not edit by hand."
      , "-- One batch eval per nixpkgs revision; use time is eval-free."
      , ""
      , "nixpkgs.index.rev : Text"
      , "nixpkgs.index.rev = \"" ++ rev ++ "\""
      , ""
      , "nixpkgs.index : [(Text, Text, Text, Text)]"
      , "nixpkgs.index ="
      , body
      , ""
      ]
  writeFileUtf8 (FilePath "src/nixpkgs-index.u") txt

upkg.lookup : Text -> [(Text, a)] -> Optional a
upkg.lookup k =
  List.findMap (cases (k2, v) -> if k2 == k then Some v else None)

-- ----------------------------------------------------------------
-- Pure planning / effectful submission. `plan` computes the whole
-- build graph with no IO ability -- the typechecker proves that
-- evaluation has no side effects, which is the guarantee Nix's
-- pure-eval mode gives by prohibition. Since the daemon computes
-- all store paths, planned nodes reference each other symbolically;
-- `submit` resolves the references as drv paths become known.

-- A store reference in a plan: a path known at plan time (from the
-- pinned index), or the drv path / output of a planned node.
type upkg.Ref = Path Text | Drv Text | Output Text

-- A node's build action: a shell script with @token@ substitution,
-- or a Unison closure. Carrying the closure in the plan is pure;
-- serializing it and harvesting its code is IO and happens in
-- submit.
type upkg.Action = Script Text | Closure ('{IO, Exception, upkg.Sh} ())

type upkg.Node =
  { name : Text
  , builder : Text
  , action : upkg.Action
  , subs : [(Text, upkg.Ref)]        -- @token@ / dep name -> reference
  , inputs : [(upkg.Ref, Text)]      -- (drv ref, output name)
  , fixed : Optional Text            -- SRI hash => fixed-output
  }

type upkg.Plan = { nodes : [upkg.Node] }  -- deps before dependents

-- Pure index lookup. A miss is a plan-time error, not a fallback
-- to the evaluator: purity means the oracle runs at pin time only.
upkg.index.get : Text -> {Exception} upkg.Pinned
upkg.index.get attr = match upkg.index.lookup attr with
  Some p -> p
  None ->
    Exception.raise
      (Generic.failure
        ("not in the pinned index (run ./run.sh index): " ++ attr)
        ())

upkg.plan : upkg.Pkg -> {Exception} upkg.Plan
upkg.plan pkg = upkg.Plan.Plan (at1 (upkg.plan.go ([], Set.empty) pkg))

upkg.plan.fetchNode :
  ([upkg.Node], Set Text) -> Text -> Text -> Text
    -> {Exception} ([upkg.Node], Set Text)
upkg.plan.fetchNode acc fname url sri = match acc with
  (nodes, seen) ->
    if Set.contains fname seen then acc
    else
      bash = upkg.index.get "bash"
      curl = upkg.index.get "curl"
      cacert = upkg.index.get "cacert"
      script =
        "export SSL_CERT_FILE=" ++ upkg.Pinned.out cacert
          ++ "/etc/ssl/certs/ca-bundle.crt; " ++ upkg.Pinned.out curl
          ++ "/bin/curl --fail --location --output \"$out\" " ++ url
      node =
        upkg.Node.Node
          fname
          (upkg.Pinned.out bash ++ "/bin/bash")
          (upkg.Action.Script script)
          []
          [ (upkg.Ref.Path (upkg.Pinned.drv bash), upkg.Pinned.output bash)
          , (upkg.Ref.Path (upkg.Pinned.drv curl), upkg.Pinned.output curl)
          , (upkg.Ref.Path (upkg.Pinned.drv cacert), upkg.Pinned.output cacert)
          ]
          (Some sri)
      (nodes :+ node, Set.insert fname seen)

-- Resolve a dep list purely: emit nodes for local/fetch deps,
-- symbolic subs and input refs for all of them. Shared by the Pkg
-- and UPkg planners.
upkg.plan.deps :
  ([upkg.Node], Set Text) -> [upkg.Dep]
    -> {Exception}
        ([upkg.Node], Set Text, [(Text, upkg.Ref)], [(upkg.Ref, Text)])
upkg.plan.deps acc deps = match acc with
  (nodes, seen) ->
    step = cases (ns, sn, subs, ins), dep -> match dep with
      upkg.Dep.Local p ->
        (ns2, sn2) = upkg.plan.go (ns, sn) p
        pn = upkg.Pkg.name p
        ( ns2, sn2
        , subs :+ (pn, upkg.Ref.Output pn)
        , ins :+ (upkg.Ref.Drv pn, "out")
        )
      upkg.Dep.Nixpkgs attr ->
        pin = upkg.index.get attr
        ( ns, sn
        , subs :+ (attr, upkg.Ref.Path (upkg.Pinned.out pin))
        , ins :+ (upkg.Ref.Path (upkg.Pinned.drv pin), upkg.Pinned.output pin)
        )
      upkg.Dep.Fetch fname url sri ->
        (ns2, sn2) = upkg.plan.fetchNode (ns, sn) fname url sri
        ( ns2, sn2
        , subs :+ (fname, upkg.Ref.Output fname)
        , ins :+ (upkg.Ref.Drv fname, "out")
        )
    List.foldLeft step (nodes, seen, [], []) deps

upkg.plan.go :
  ([upkg.Node], Set Text) -> upkg.Pkg
    -> {Exception} ([upkg.Node], Set Text)
upkg.plan.go acc pkg = match pkg with
  upkg.Pkg.Pkg name script deps -> match acc with
    (nodes, seen) ->
      if Set.contains name seen then acc
      else
        (nodes2, seen2, subs, ins) =
          upkg.plan.deps (nodes, Set.insert name seen) deps
        bash = upkg.index.get "bash"
        node =
          upkg.Node.Node
            name
            (upkg.Pinned.out bash ++ "/bin/bash")
            (upkg.Action.Script script)
            subs
            (ins :+ (upkg.Ref.Path (upkg.Pinned.drv bash), upkg.Pinned.output bash))
            None
        (nodes2 :+ node, seen2)

-- Plan a Unison-built package: same dep resolution, ucm as the
-- builder, the build closure carried as a value.
upkg.planU : upkg.UPkg -> {Exception} upkg.Plan
upkg.planU up = match up with
  upkg.UPkg.UPkg name build deps ->
    (nodes, _, subs, ins) = upkg.plan.deps ([], Set.empty) deps
    ucm = upkg.index.get "unison-ucm"
    node =
      upkg.Node.Node
        name
        (upkg.Pinned.out ucm ++ "/bin/ucm")
        (upkg.Action.Closure build)
        subs
        (ins :+ (upkg.Ref.Path (upkg.Pinned.drv ucm), upkg.Pinned.output ucm))
        None
    upkg.Plan.Plan (nodes :+ node)

-- Fold the plan into the daemon: add each drv, learn its path,
-- resolve downstream references. Returns the root drv path.
-- What submit has learned about a planned node: its drv path and
-- the text dependents splice for its output (a placeholder for CA
-- nodes, the literal fixed path for FODs).
type upkg.Built = { drv : Text, out : Text }

upkg.submit : upkg.Plan -> {IO, Exception} Text
upkg.submit p = match p with
  upkg.Plan.Plan nodes ->
    look = acc -> n -> match Map.get n acc with
      Some b -> b
      None -> bug ("plan out of order", n)
    step = acc -> cases
      upkg.Node.Node name builder action subs ins fixed ->
        resolveDrv = cases
          upkg.Ref.Path t -> t
          upkg.Ref.Drv n -> upkg.Built.drv (look acc n)
          upkg.Ref.Output n -> upkg.Built.drv (look acc n)
        resolveOut = cases
          upkg.Ref.Path t -> t
          upkg.Ref.Drv n -> upkg.Built.drv (look acc n)
          upkg.Ref.Output n -> upkg.Built.out (look acc n)
        depDrvs = List.map (cases (ref, on) -> (resolveDrv ref, on)) ins
        drvPath = match action with
          upkg.Action.Script script ->
            script' =
              List.foldLeft
                (s -> cases (tok, ref) ->
                  Text.replaceAll ("@" ++ tok ++ "@") (resolveOut ref) s)
                script
                subs
            (outEnv, outsJson) = match fixed with
              Some sri -> ("", upkg.fixedOutputs sri)
              None -> (upkg.placeholder "out", upkg.caOutputs)
            upkg.addDrv
              (upkg.drvJson' name builder script' depDrvs outEnv outsJson)
          upkg.Action.Closure build ->
            runnerPath =
              upkg.chomp
                (upkg.nix
                  ["store", "add", "--mode", "flat", ".ucm-compiled/runner.uc"]
                  "")
            scriptFile = ".ucm-compiled/script-" ++ name ++ ".uv"
            writeFile (FilePath scriptFile) (upkg.ship build)
            uvPath =
              upkg.chomp
                (upkg.nix ["store", "add", "--mode", "flat", scriptFile] "")
            pathEnv =
              Text.join
                ":"
                (List.map (cases (_, ref) -> resolveOut ref ++ "/bin") subs)
            depEnvs =
              List.map (cases (n, ref) -> ("dep_" ++ n, resolveOut ref)) subs
            envs =
              [("PATH", pathEnv), ("out", upkg.placeholder "out")] ++ depEnvs
            upkg.addDrv
              (upkg.drvJsonU
                name
                builder
                ["run.compiled", runnerPath, uvPath]
                envs
                depDrvs
                [runnerPath, uvPath])
        outText = match fixed with
          Some _ ->
            upkg.chomp
              (upkg.exec "nix-store" ["--query", "--outputs", drvPath] "")
          None -> upkg.upstreamPlaceholder drvPath "out"
        printLine ("  drv " ++ name ++ " -> " ++ drvPath)
        Map.put name (upkg.Built.Built drvPath outText) acc
    final = List.foldLeft step Map.empty nodes
    match List.last nodes with
      Some n -> upkg.Built.drv (look final (upkg.Node.name n))
      None -> Exception.raise (Generic.failure "empty plan" ())

upkg.realise : upkg.Pkg -> {IO, Exception} Text
upkg.realise pkg = upkg.submit (upkg.plan pkg)

-- ----------------------------------------------------------------
-- Typed derivations. `nix derivation show` emits the same schema
-- version 4 JSON that `nix derivation add` accepts, so a nixpkgs
-- derivation round-trips through a plain Unison value. An override
-- is then a pure Drv -> Drv function. No overrideAttrs, no
-- fixpoints, no mkDerivation magic.

-- An output is input-addressed (basename of the store path, fixed
-- at eval time), floating CA (daemon computes the path), or fixed
-- (SRI hash + method).
type upkg.Out = Addressed Text | Floating | Fixed Text Text

type upkg.Drv =
  { name : Text
  , system : Text
  , builder : Text
  , args : [Text]
  , env : [(Text, Text)]
  , inputDrvs : [(Text, [Text])]
  , inputSrcs : [Text]
  , outputs : [(Text, upkg.Out)]
  , attrs : Optional Json
  }

-- Small Json access kit. The lib exposes the constructors, so this
-- is all we need instead of a decoder framework.

upkg.json.get : Text -> Json -> {Exception} Json
upkg.json.get k j = match j with
  Json.Object kvs -> match upkg.lookup k kvs with
    Some v -> v
    None -> Exception.raise (Generic.failure ("json: missing key " ++ k) ())
  _ -> Exception.raise (Generic.failure ("json: not an object at " ++ k) ())

upkg.json.opt : Text -> Json -> Optional Json
upkg.json.opt k j = match j with
  Json.Object kvs -> upkg.lookup k kvs
  _ -> None

upkg.json.asText : Json -> {Exception} Text
upkg.json.asText j = match j with
  Json.Text t -> t
  _ -> Exception.raise (Generic.failure "json: not a string" ())

upkg.json.asArray : Json -> {Exception} [Json]
upkg.json.asArray j = match j with
  Json.Array xs -> xs
  _ -> Exception.raise (Generic.failure "json: not an array" ())

upkg.json.asObject : Json -> {Exception} [(Text, Json)]
upkg.json.asObject j = match j with
  Json.Object kvs -> kvs
  _ -> Exception.raise (Generic.failure "json: not an object" ())

-- Rewrite every string leaf. Keys stay as they are.
upkg.json.mapText : (Text -> Text) -> Json -> Json
upkg.json.mapText f j = match j with
  Json.Text t -> Json.Text (f t)
  Json.Array xs -> Json.Array (List.map (upkg.json.mapText f) xs)
  Json.Object kvs ->
    Json.Object
      (List.map (cases (k, v) -> (k, upkg.json.mapText f v)) kvs)
  _ -> j

-- Upsert a key in a Json object. Non-objects pass through.
upkg.json.set : Text -> Json -> Json -> Json
upkg.json.set k v j = match j with
  Json.Object kvs ->
    if List.any (cases (k2, _) -> k2 Text.== k) kvs
    then
      Json.Object
        (List.map
          (cases (k2, v2) -> if k2 Text.== k then (k2, v) else (k2, v2))
          kvs)
    else Json.Object (kvs :+ (k, v))
  _ -> j

upkg.Drv.fromJson : Json -> {Exception} upkg.Drv
upkg.Drv.fromJson j =
  texts = xs -> List.map upkg.json.asText (upkg.json.asArray xs)
  pairText = cases (k, v) -> (k, upkg.json.asText v)
  out = o -> match upkg.json.opt "path" o with
    Some p -> upkg.Out.Addressed (upkg.json.asText p)
    None -> match upkg.json.opt "hash" o with
      Some h ->
        upkg.Out.Fixed
          (upkg.json.asText h)
          (upkg.json.asText (upkg.json.get "method" o))
      None -> upkg.Out.Floating
  inputs = upkg.json.get "inputs" j
  drvIn = cases (k, v) -> (k, texts (upkg.json.get "outputs" v))
  upkg.Drv.Drv
    (upkg.json.asText (upkg.json.get "name" j))
    (upkg.json.asText (upkg.json.get "system" j))
    (upkg.json.asText (upkg.json.get "builder" j))
    (texts (upkg.json.get "args" j))
    (List.map pairText (upkg.json.asObject (upkg.json.get "env" j)))
    (List.map drvIn (upkg.json.asObject (upkg.json.get "drvs" inputs)))
    (texts (upkg.json.get "srcs" inputs))
    (List.map
      (cases (k, v) -> (k, out v))
      (upkg.json.asObject (upkg.json.get "outputs" j)))
    (upkg.json.opt "structuredAttrs" j)

upkg.Drv.toJson : upkg.Drv -> Json
upkg.Drv.toJson d = match d with
  upkg.Drv.Drv name system builder args env inDrvs inSrcs outputs attrs ->
    outJson = o -> match o with
      upkg.Out.Addressed p -> Json.object [("path", Json.text p)]
      upkg.Out.Floating ->
        Json.object
          [("hashAlgo", Json.text "sha256"), ("method", Json.text "nar")]
      upkg.Out.Fixed h m ->
        Json.object [("hash", Json.text h), ("method", Json.text m)]
    inDrv = cases
      (k, outs) ->
        ( k
        , Json.object
            [ ("dynamicOutputs", Json.object [])
            , ("outputs", Json.array (List.map Json.text outs))
            ]
        )
    kv = cases (k, v) -> (k, Json.text v)
    base =
      [ ("args", Json.array (List.map Json.text args))
      , ("builder", Json.text builder)
      , ("env", Json.object (List.map kv env))
      , ( "inputs"
        , Json.object
            [ ("drvs", Json.object (List.map inDrv inDrvs))
            , ("srcs", Json.array (List.map Json.text inSrcs))
            ]
        )
      , ("name", Json.text name)
      , ( "outputs"
        , Json.object
            (List.map (cases (k, v) -> (k, outJson v)) outputs)
        )
      ]
    withAttrs = match attrs with
      Some a -> base :+ ("structuredAttrs", a)
      None -> base
    Json.object
      (withAttrs ++ [("system", Json.text system), ("version", Json.nat 4)])

-- Turn an input-addressed derivation into a floating CA one. The
-- old output paths become placeholders everywhere, and the daemon
-- computes fresh paths at build time. This is what makes a mutated
-- nixpkgs derivation buildable: its identity changed, so its old
-- output paths are lies, and CA sidesteps recomputing them.
upkg.Drv.caify : upkg.Drv -> upkg.Drv
upkg.Drv.caify d =
  subs =
    List.foldLeft
      (acc -> cases
        (oname, upkg.Out.Addressed path) ->
          acc :+ ("/nix/store/" ++ path, upkg.placeholder oname)
        _ -> acc)
      []
      (upkg.Drv.outputs d)
  swap = t -> let
    List.foldLeft
      (s -> cases (old, new) -> Text.replaceAll old new s)
      t
      subs
  d
    |> upkg.Drv.env.modify
         (List.map (cases (k, v) -> (k, swap v)))
    |> upkg.Drv.args.modify (List.map swap)
    |> upkg.Drv.attrs.modify (Optional.map (upkg.json.mapText swap))
    |> upkg.Drv.outputs.modify
         (List.map
           (cases
             (k, upkg.Out.Fixed h m) -> (k, upkg.Out.Fixed h m)
             (k, _) -> (k, upkg.Out.Floating)))

upkg.Drv.setEnv : Text -> Text -> upkg.Drv -> upkg.Drv
upkg.Drv.setEnv k v d =
  upsert = kvs -> let
    if List.any (cases (k2, _) -> k2 Text.== k) kvs
    then
      List.map
        (cases (k2, v2) -> if k2 Text.== k then (k2, v) else (k2, v2))
        kvs
    else kvs :+ (k, v)
  upkg.Drv.env.modify upsert d

upkg.Drv.setAttr : Text -> Json -> upkg.Drv -> upkg.Drv
upkg.Drv.setAttr k v d =
  upkg.Drv.attrs.modify (Optional.map (upkg.json.set k v)) d

upkg.Drv.rename : Text -> upkg.Drv -> upkg.Drv
upkg.Drv.rename n d =
  d |> upkg.Drv.name.set n |> upkg.Drv.setAttr "name" (Json.text n)

-- Import one nixpkgs derivation as a typed value.
upkg.importDrv : Text -> {IO, Exception} upkg.Drv
upkg.importDrv attr =
  raw = upkg.nix ["derivation", "show", "nixpkgs#" ++ attr] ""
  j = Json.fromText raw
  match upkg.json.asObject (upkg.json.get "derivations" j) with
    [(_, dj)] -> upkg.Drv.fromJson dj
    _ ->
      Exception.raise
        (Generic.failure ("expected one derivation: " ++ attr) ())

upkg.Drv.realise : upkg.Drv -> {IO, Exception} Text
upkg.Drv.realise d = upkg.addDrv (Json.toText (upkg.Drv.toJson d))

-- ----------------------------------------------------------------
-- Deep overrides: import a whole drv closure, override any node,
-- rewrite everything downstream. What nixpkgs does with
-- overrideAttrs and evaluator fixpoints is a pure graph
-- transformation here. Unaffected subgraphs keep their
-- input-addressed drvs and literal paths, so the binary cache
-- still serves them.

-- Closure keyed by drv basename, from `nix derivation show -r`.
upkg.importClosure : Text -> {IO, Exception} (Map Text upkg.Drv)
upkg.importClosure drvPath =
  raw = upkg.nix ["derivation", "show", "-r", drvPath] ""
  j = Json.fromText raw
  ds = upkg.json.asObject (upkg.json.get "derivations" j)
  Map.fromList (List.map (cases (b, dj) -> (b, upkg.Drv.fromJson dj)) ds)

-- Does node b transitively depend on a target? Memoized; nodes
-- outside the closure map count as unaffected.
upkg.closure.mark :
  Map Text upkg.Drv -> (Text -> Boolean) -> Map Text Boolean -> Text
    -> (Map Text Boolean, Boolean)
upkg.closure.mark closure isTarget cache b =
  match Map.get b cache with
    Some r -> (cache, r)
    None ->
      if isTarget b then (Map.put b true cache, true)
      else match Map.get b closure with
        None -> (Map.put b false cache, false)
        Some d ->
          step = cases (c, hit), (i, _) ->
            (c2, r) = upkg.closure.mark closure isTarget c i
            (c2, hit || r)
          (cache2, hit) =
            List.foldLeft step (cache, false) (upkg.Drv.inputDrvs d)
          (Map.put b hit cache2, hit)

upkg.closure.markAll :
  Map Text upkg.Drv -> Set Text -> Map Text Boolean
upkg.closure.markAll closure targets =
  isT = b -> Set.contains b targets
  List.foldLeft
    (c -> cases (b, _) -> at1 (upkg.closure.mark closure isT c b))
    Map.empty
    (Map.toList closure)

-- Rewrite bottom-up. An affected drv gets: new inputDrvs keys for
-- its rewritten inputs, upstream placeholders in place of their old
-- literal output paths, the user override if it is a target, and
-- CA-ification. Returns the new drv path; the cache maps old
-- basename -> new drv path.
upkg.closure.rewrite :
  Map Text upkg.Drv -> Map Text Boolean -> Set Text
    -> (upkg.Drv -> upkg.Drv) -> Map Text Text -> Text
    -> {IO, Exception} (Map Text Text, Text)
upkg.closure.rewrite closure marks targets f cache b =
  affected = k -> Map.getOrElse false k marks
  match Map.get b cache with
    Some p -> (cache, p)
    None ->
      if Boolean.not (affected b) then (cache, "/nix/store/" ++ b)
      else
        d = Map.getOrBug b "not in closure" closure
        step = cases (c, ins, subs), (i, outs) ->
          if Boolean.not (affected i) then (c, ins :+ (i, outs), subs)
          else
            (c2, newPath) =
              upkg.closure.rewrite closure marks targets f c i
            iDrv = Map.getOrBug i "not in closure" closure
            subFor = ss -> cases
              (oname, upkg.Out.Addressed pth) ->
                ss
                  :+ ( "/nix/store/" ++ pth
                     , upkg.upstreamPlaceholder newPath oname
                     )
              _ -> ss
            subs2 = List.foldLeft subFor subs (upkg.Drv.outputs iDrv)
            (c2, ins :+ (Text.drop 11 newPath, outs), subs2)
        (cache2, newIns, subs) =
          List.foldLeft step (cache, [], []) (upkg.Drv.inputDrvs d)
        swap = t -> let
          List.foldLeft
            (s -> cases (o, n) -> Text.replaceAll o n s)
            t
            subs
        d1 =
          d
            |> upkg.Drv.inputDrvs.set newIns
            |> upkg.Drv.env.modify
                 (List.map (cases (k, v) -> (k, swap v)))
            |> upkg.Drv.args.modify (List.map swap)
            |> upkg.Drv.attrs.modify
                 (Optional.map (upkg.json.mapText swap))
        d2 = if Set.contains b targets then f d1 else d1
        newPath = upkg.Drv.realise (upkg.Drv.caify d2)
        printLine ("  rewrite " ++ upkg.Drv.name d ++ " -> " ++ newPath)
        (Map.put b newPath cache2, newPath)

-- ----------------------------------------------------------------
-- Unison as the builder language. The build script that runs
-- inside the sandbox is Unison too: compiled to .uc bytecode on
-- the host, added to the store, executed by nixpkgs' ucm with
-- `run.compiled`. The bash-like dialect is the Sh ability; its
-- handler runs in the sandbox with inherited stdio, so `run`
-- output lands in the build log.
--
-- Dependency paths and $out travel as plain env vars (PATH,
-- dep_<name>, out), because child processes need PATH in the real
-- environment anyway. The daemon rewrites the placeholders in env
-- like everywhere else.

ability upkg.Sh where
  run : Text -> [Text] -> ()
  cd : Text -> ()
  out : Text
  dep : Text -> Text

upkg.Sh.build : '{IO, Exception, upkg.Sh} a -> {IO, Exception} a
upkg.Sh.build prog =
  h = cases
    { r } -> r
    { upkg.Sh.run cmd args -> k } ->
      printLine ("$ " ++ cmd ++ " " ++ Text.join " " args)
      code = IO.Process.call cmd args
      match code with
        0 -> handle k () with h
        _ ->
          Exception.raise
            (Generic.failure
              (cmd ++ " failed with exit code " ++ Nat.toText code)
              ())
    { upkg.Sh.cd p -> k } ->
      FilePath.setCurrentDirectory (FilePath p)
      handle k () with h
    { upkg.Sh.out -> k } -> handle k (IO.getEnv "out") with h
    { upkg.Sh.dep n -> k } -> handle k (IO.getEnv ("dep_" ++ n)) with h
  handle !prog with h

-- A package built by Unison. The build script is a first-class
-- value, not a named term: realiseU ships the closure to the
-- sandbox the way distributed Unison ships closures to remote
-- nodes -- Value.serialize for the value, Code.serialize for the
-- transitive code of its dependencies. One generic runner (see
-- upkg.Sh.runner) is compiled to bytecode once; it caches the
-- shipped code and loads the value.
type upkg.UPkg =
  { name : Text
  , build : '{IO, Exception, upkg.Sh} ()
  , deps : [upkg.Dep]
  }

-- Transitive non-builtin code of a set of links. Builtins exist on
-- both sides and their code cannot serialize, so they are skipped.
upkg.codeOf :
  [Link.Term] -> [(Link.Term, Code)] -> {IO, Exception} [(Link.Term, Code)]
upkg.codeOf pending acc = match pending with
  [] -> acc
  link +: rest ->
    if List.any (cases (l, _) -> l === link) acc then upkg.codeOf rest acc
    else if Text.startsWith "##" (Link.Term.toText link) then
      upkg.codeOf rest acc
    else match Code.lookup link with
      None -> upkg.codeOf rest acc
      Some code ->
        upkg.codeOf (rest ++ Code.dependencies code) (acc :+ (link, code))

-- Pack a value and the code it needs into one Bytes. The outer
-- envelope is plain data, so it loads anywhere.
upkg.ship : a -> {IO, Exception} Bytes
upkg.ship v =
  val = Value.value v
  bytes = Value.serialize_v4 val
  pairs =
    List.map
      (cases
        (l, c) -> (Value.serialize_v4 (Value.value l), Code.serialize_v3 c))
      (upkg.codeOf (Value.dependencies val) [])
  Value.serialize_v4 (Value.value (bytes, pairs))

upkg.unship : Bytes -> {IO, Exception} a
upkg.unship b =
  bad = msg -> Exception.raise (Generic.failure msg ())
  (vb, pairs) = match Value.load (Value.deserialize b) with
    Left _ -> bad "unship: cannot load the envelope"
    Right e -> (e : (Bytes, [(Bytes, Bytes)]))
  toPair = cases
    (lb, cb) ->
      link = match Value.load (Value.deserialize lb) with
        Left _ -> bad "unship: cannot load a code link"
        Right l -> (l : Link.Term)
      (link, Code.deserialize cb)
  _ = Code.cache_ (List.map toPair pairs)
  match Value.load (Value.deserialize vb) with
    Left missing ->
      bad
        ("unship: still missing "
          ++ Text.join ", " (List.map Link.Term.toText missing))
    Right v -> v

-- The generic sandbox entrypoint: argv is the shipped script file.
upkg.Sh.runner : '{IO, Exception} ()
upkg.Sh.runner = do
  match !IO.getArgs with
    [file] ->
      script = upkg.unship (readFile (FilePath file))
      upkg.Sh.build (script : '{IO, Exception, upkg.Sh} ())
    _ ->
      Exception.raise (Generic.failure "usage: runner <script.uv>" ())

-- Derivation JSON for a ucm-run builder: explicit args, env and
-- inputs.srcs, no structured attrs (env is the API here).
upkg.drvJsonU :
  Text -> Text -> [Text] -> [(Text, Text)] -> [(Text, Text)] -> [Text]
    -> Text
upkg.drvJsonU name builder args envs depDrvs srcs =
  inputDrv = cases
    (drvPath, outNames) ->
      ( Text.drop 11 drvPath
      , Json.object
          [ ("dynamicOutputs", Json.object [])
          , ("outputs", Json.array (List.map Json.text outNames))
          ]
      )
  Json.toText
    (Json.object
      [ ("args", Json.array (List.map Json.text args))
      , ("builder", Json.text builder)
      , ( "env"
        , Json.object
            (List.map (cases (k, v) -> (k, Json.text v)) envs)
        )
      , ( "inputs"
        , Json.object
            [ ( "drvs"
              , Json.object (List.map inputDrv (upkg.groupDeps depDrvs))
              )
            , ( "srcs"
              , Json.array (List.map (s -> Json.text (Text.drop 11 s)) srcs)
              )
            ]
        )
      , ("name", Json.text name)
      , ("outputs", upkg.caOutputs)
      , ("system", Json.text upkg.system)
      , ("version", Json.nat 4)
      ])

upkg.realiseU : upkg.UPkg -> {IO, Exception} Text
upkg.realiseU up = upkg.submit (upkg.planU up)

-- ----------------------------------------------------------------
-- The Cargo ecosystem, end to end: parse the lockfile purely,
-- derive one fixed-output derivation per registry crate with the
-- hash straight from the lockfile (nothing for a human to
-- maintain), assemble the vendor tree inside the sandbox with a
-- Unison closure, build offline.

type upkg.cargo.Crate =
  { name : Text, version : Text, checksum : Optional Text }

-- Minimal parser for the Cargo.lock TOML subset: [[package]]
-- blocks with name/version/checksum keys. Pure.
upkg.cargo.parseLock : Text -> [upkg.cargo.Crate]
upkg.cargo.parseLock lock =
  quoted = l -> match Text.split ?" l with
    [_, v, _] -> Some v
    _ -> None
  flush = cases (cs, name, ver, sum) -> match (name, ver) with
    (Some n, Some v) -> cs :+ upkg.cargo.Crate.Crate n v sum
    _ -> cs
  step = cases (cs, name, ver, sum), l ->
    if l Text.== "[[package]]" then
      (flush (cs, name, ver, sum), None, None, None)
    else if Text.startsWith "name = " l then (cs, quoted l, ver, sum)
    else if Text.startsWith "version = " l then (cs, name, quoted l, sum)
    else if Text.startsWith "checksum = " l then (cs, name, ver, quoted l)
    else (cs, name, ver, sum)
  flush (List.foldLeft step ([], None, None, None) (Text.split ?\n lock))

-- Cargo.lock checksums are sha256 hex; FODs want SRI.
upkg.cargo.sri : Text -> {Exception} Text
upkg.cargo.sri hex =
  "sha256-" ++ Text.fromUtf8 (Bytes.toBase64 (Bytes.fromHex hex))

upkg.cargo.crateUrl : Text -> Text -> Text
upkg.cargo.crateUrl name version =
  "https://static.crates.io/crates/" ++ name ++ "/" ++ version
    ++ "/download"

-- A Rust package from a crates.io source tarball plus its
-- committed Cargo.lock. Registry crates (checksummed entries)
-- become Fetch deps; the build closure vendors them and runs
-- cargo offline.
upkg.cargo.pkg : Text -> Text -> Text -> Text -> {Exception} upkg.UPkg
upkg.cargo.pkg name version srcSri lock =
  crates =
    List.filterMap
      (cases
        upkg.cargo.Crate.Crate n v (Some sum) ->
          if n Text.== name then None else Some (n, v, sum)
        _ -> None)
      (upkg.cargo.parseLock lock)
  srcName = name ++ "-src"
  crateDeps =
    List.map
      (cases (n, v, sum) ->
        upkg.Dep.Fetch
          (n ++ "-" ++ v)
          (upkg.cargo.crateUrl n v)
          (upkg.cargo.sri sum))
      crates
  toolchain =
    List.map
      upkg.Dep.Nixpkgs
      ["cargo", "rustc", "gcc", "gnutar", "gzip", "coreutils"]
  script = do
    use upkg.Sh run dep cd
    out = upkg.Sh.out
    run "tar" ["xzf", dep srcName]
    cd (name ++ "-" ++ version)
    cwd = FilePath.toText !FilePath.getCurrentDirectory
    run "mkdir" ["-p", "vendor", ".cargo", "cargo-home"]
    vendorOne = cases (n, v, sum) ->
      dir = "vendor/" ++ n ++ "-" ++ v
      run "mkdir" ["-p", dir]
      run "tar" ["xzf", dep (n ++ "-" ++ v), "--strip-components=1", "-C", dir]
      writeFileUtf8
        (FilePath (dir ++ "/.cargo-checksum.json"))
        ("{\"files\":{},\"package\":\"" ++ sum ++ "\"}")
    _ = List.map vendorOne crates
    writeFileUtf8
      (FilePath ".cargo/config.toml")
      (Text.join
        "\n"
        [ "[source.crates-io]"
        , "replace-with = \"vendored-sources\""
        , "[source.vendored-sources]"
        , "directory = \"" ++ cwd ++ "/vendor\""
        , ""
        ])
    -- No setenv in base yet; coreutils env(1) is the workaround.
    run
      "env"
      [ "CARGO_HOME=" ++ cwd ++ "/cargo-home"
      , "cargo", "build", "--release", "--offline", "--locked"
      ]
    run "mkdir" ["-p", out ++ "/bin"]
    run "cp" ["target/release/" ++ name, out ++ "/bin/"]
  upkg.UPkg.UPkg
    (name ++ "-" ++ version)
    script
    (upkg.Dep.Fetch srcName (upkg.cargo.crateUrl name version) srcSri
      +: (crateDeps ++ toolchain))

-- ----------------------------------------------------------------
-- A tiny package set.

pkgs.greeting : upkg.Pkg
pkgs.greeting =
  upkg.Pkg.Pkg
    "greeting"
    "echo hello from the unison frontend > $out"
    []

pkgs.banner : upkg.Pkg
pkgs.banner =
  upkg.Pkg.Pkg
    "banner"
    "read -r line < @greeting@; { echo \"$line\"; echo this is nix without nixexpr; } > $out"
    [upkg.Dep.Local pkgs.greeting]

-- Uses real nixpkgs packages: hello from the binary cache, tr from
-- coreutils. Mixes a local CA dep (banner) with nixpkgs deps.
pkgs.shout : upkg.Pkg
pkgs.shout =
  upkg.Pkg.Pkg
    "shout"
    "{ @hello@/bin/hello; @coreutils@/bin/tr a-z A-Z < @banner@; } > $out"
    [ upkg.Dep.Nixpkgs "hello"
    , upkg.Dep.Nixpkgs "coreutils"
    , upkg.Dep.Local pkgs.banner
    ]

-- The milestone: compile GNU hello 2.12.1 from the upstream
-- tarball. nixpkgs ships 2.12.3, so this is not a replay -- the
-- source fetch and build are ours. Toolchain from nixpkgs.
pkgs.gnuhello : upkg.Pkg
pkgs.gnuhello =
  script =
    Text.join
      "\n"
      [ "set -e"
      , "export PATH=@bash@/bin:@coreutils@/bin:@gnugrep@/bin:@gnused@/bin:@gawk@/bin:@gnutar@/bin:@gzip@/bin:@gnumake@/bin:@gcc@/bin:@gettext@/bin"
      , "export SHELL=@bash@/bin/bash"
      , "tar xzf @hello-src@"
      , "cd hello-2.12.1"
      , "./configure --prefix=$out"
      , "make"
      , "make install"
      ]
  toolchain =
    List.map
      upkg.Dep.Nixpkgs
      [ "bash", "coreutils", "gnugrep", "gnused", "gawk", "gnutar"
      , "gzip", "gnumake", "gcc", "gettext"
      ]
  src =
    upkg.Dep.Fetch
      "hello-src"
      "https://ftp.gnu.org/gnu/hello/hello-2.12.1.tar.gz"
      "sha256-jZkUKv2SV28wsM18tCqNxoCZmLxdYH2Idh9RLibH2yA="
  upkg.Pkg.Pkg "hello-2.12.1" script (src +: toolchain)

-- The payoff of typed derivations: a nixpkgs override is a pure
-- function on a value. Rename, add a configure flag, drop the test
-- suite. The daemon rebuilds hello from source under the new
-- identity.
pkgs.uniHello.override : upkg.Drv -> upkg.Drv
pkgs.uniHello.override d =
  d
    |> upkg.Drv.rename "hello-uni"
    |> upkg.Drv.setAttr
         "configureFlags"
         (Json.array [Json.text "--program-prefix=uni-"])
    |> upkg.Drv.setAttr "doCheck" (Json.Boolean false)
    |> upkg.Drv.setAttr "doInstallCheck" (Json.Boolean false)

pkgs.registry : [(Text, upkg.Pkg)]
pkgs.registry =
  [ ("greeting", pkgs.greeting)
  , ("banner", pkgs.banner)
  , ("shout", pkgs.shout)
  , ("hello", pkgs.gnuhello)
  ]

-- Packages whose build scripts are Unison, not bash. The script is
-- a first-class value over the Sh ability -- an inline lambda is
-- fine. realiseU ships the closure (value + code) to the sandbox;
-- a generic runner loads and runs it there.

pkgs.ugreeting : upkg.UPkg
pkgs.ugreeting =
  upkg.UPkg.UPkg
    "ugreeting"
    (do writeFileUtf8 (FilePath upkg.Sh.out) "hello from a unison builder\n")
    []

-- GNU hello again, but the build script is Unison end to end.
pkgs.uhello : upkg.UPkg
pkgs.uhello =
  script = do
    use upkg.Sh run cd dep
    run "tar" ["xzf", dep "hello-src"]
    cd "hello-2.12.1"
    run "./configure" ["--prefix=" ++ upkg.Sh.out]
    run "make" []
    run "make" ["install"]
  src =
    upkg.Dep.Fetch
      "hello-src"
      "https://ftp.gnu.org/gnu/hello/hello-2.12.1.tar.gz"
      "sha256-jZkUKv2SV28wsM18tCqNxoCZmLxdYH2Idh9RLibH2yA="
  toolchain =
    List.map
      upkg.Dep.Nixpkgs
      [ "bash", "coreutils", "gnugrep", "gnused", "gawk", "gnutar"
      , "gzip", "gnumake", "gcc", "gettext"
      ]
  upkg.UPkg.UPkg "uhello-2.12.1" script (src +: toolchain)

-- ----------------------------------------------------------------
-- Configuration across stages: one typed record steers the dep
-- graph at eval time, renders nginx.conf at build time (the
-- renderer ships with the closure), and prints from the run-time
-- wrapper. What nixpkgs does with module options -> conf strings
-- -> wrappers is one value here.

-- A run-time secret is a reference, never a value: it names where
-- the wrapper finds the secret at startup. It cannot end up in the
-- store because the frontend never sees it. The stage each field
-- binds at is visible in its type: Nat and Boolean bake at build
-- time, Secret defers to run time.
type upkg.Secret = FromEnv Text | FromFile Text

type upkg.NginxConfig =
  { port : Nat
  , workers : Nat
  , gzip : Boolean
  , content : upkg.Pkg
  , auth : Optional (Text, upkg.Secret)
  }

-- Pure conf renderer. Runs inside the sandbox as shipped code.
upkg.nginx.conf : Nat -> Nat -> Boolean -> Boolean -> Text -> Text
upkg.nginx.conf port workers gzip authOn root =
  Text.join
    "\n"
    [ "daemon off;"
    , "worker_processes " ++ Nat.toText workers ++ ";"
    , "error_log stderr;"
    , "pid /tmp/nginx-unison.pid;"
    , "events { worker_connections 128; }"
    , "http {"
    , "  access_log off;"
    , "  default_type text/html;"
    , "  client_body_temp_path /tmp/nginx-unison-body;"
    , "  proxy_temp_path /tmp/nginx-unison-proxy;"
    , "  fastcgi_temp_path /tmp/nginx-unison-fcgi;"
    , "  uwsgi_temp_path /tmp/nginx-unison-uwsgi;"
    , "  scgi_temp_path /tmp/nginx-unison-scgi;"
    , "  " ++ (if gzip then "gzip on;" else "gzip off;")
    , "  server {"
    , "    listen 127.0.0.1:" ++ Nat.toText port ++ ";"
    , "    root " ++ root ++ ";"
    , "    index index.html;"
    , if authOn then
        Text.join
          "\n"
          [ "    auth_basic \"unison\";"
          , "    auth_basic_user_file /tmp/nginx-unison-htpasswd;"
          ]
      else "    # no auth"
    , "  }"
    , "}"
    , ""
    ]

upkg.mkNginx : upkg.NginxConfig -> upkg.UPkg
upkg.mkNginx cfg =
  -- Destructure before the lambda: the closure captures these
  -- scalars, not the whole record (which drags the content Pkg).
  port = upkg.NginxConfig.port cfg
  workers = upkg.NginxConfig.workers cfg
  gzip = upkg.NginxConfig.gzip cfg
  contentName = upkg.Pkg.name (upkg.NginxConfig.content cfg)
  -- The wrapper preamble that resolves the secret at run time.
  -- Only shell text is captured; the secret itself never exists
  -- at eval or build time.
  authPre = match upkg.NginxConfig.auth cfg with
    None -> []
    Some (user, upkg.Secret.FromEnv var) ->
      [ ": \"${" ++ var ++ ":?set " ++ var
          ++ " to the basic auth password}\""
      , "umask 077"
      , "printf '%s:{PLAIN}%s\\n' '" ++ user ++ "' \"$" ++ var
          ++ "\" > /tmp/nginx-unison-htpasswd"
      ]
    Some (user, upkg.Secret.FromFile path) ->
      [ "umask 077"
      , "printf '%s:{PLAIN}%s\\n' '" ++ user ++ "' \"$(cat " ++ path
          ++ ")\" > /tmp/nginx-unison-htpasswd"
      ]
  authOn = Boolean.not (List.isEmpty authPre)
  script = do
    use upkg.Sh run dep
    out = upkg.Sh.out
    html = out ++ "/html"
    run "mkdir" ["-p", html, out ++ "/bin"]
    run "cp" [dep contentName, html ++ "/index.html"]
    writeFileUtf8
      (FilePath (out ++ "/nginx.conf"))
      (upkg.nginx.conf port workers gzip authOn html)
    writeFileUtf8
      (FilePath (out ++ "/bin/serve"))
      (Text.join
        "\n"
        ([ "#!/bin/sh"
         , "echo 'serving " ++ contentName ++ " on http://127.0.0.1:"
             ++ Nat.toText port ++ "' >&2"
         ]
          ++ authPre
          ++ [ "exec " ++ dep "nginx" ++ "/bin/nginx -e stderr -c " ++ out
                 ++ "/nginx.conf"
             , ""
             ]))
    run "chmod" ["+x", out ++ "/bin/serve"]
  upkg.UPkg.UPkg
    ("nginx-" ++ contentName)
    script
    [ upkg.Dep.Nixpkgs "nginx"
    , upkg.Dep.Nixpkgs "coreutils"
    , upkg.Dep.Local (upkg.NginxConfig.content cfg)
    ]

-- The instance: serve the banner built by our own frontend, with
-- basic auth whose password arrives at run time via $NGINX_PASSWORD.
pkgs.unginx : upkg.UPkg
pkgs.unginx =
  upkg.mkNginx
    (upkg.NginxConfig.NginxConfig
      8080
      2
      true
      pkgs.banner
      (Some ("admin", upkg.Secret.FromEnv "NGINX_PASSWORD")))

pkgs.uregistry : [(Text, upkg.UPkg)]
pkgs.uregistry =
  [ ("ugreeting", pkgs.ugreeting)
  , ("uhello", pkgs.uhello)
  , ("nginx", pkgs.unginx)
  ]

-- ----------------------------------------------------------------
-- Entry points.

upkg.test.main : '{IO, Exception} ()
upkg.test.main = do
  expectOut = "/1rz4g4znpzjwh1xymhjpm42vipw92pr73vdgl6xs1hycac8kf2n9"
  gotOut = upkg.placeholder "out"
  expectUp = "/06vf5fh13wskpg2pr3wdh7r95xhyx1j9sp8y3qga3b1qlpbjpq49"
  gotUp =
    upkg.upstreamPlaceholder
      "/nix/store/b9mn5w3x4p2mi9y5344pfykak46f71ys-dep-a.drv" "out"
  check = label -> expect -> got -> let
    if expect == (got : Text)
      then printLine (label ++ ": ok")
      else printLine (label ++ ": FAIL got " ++ got)
  check "own-output placeholder" expectOut gotOut
  check "upstream placeholder" expectUp gotUp

upkg.main : '{IO, Exception} ()
upkg.main = do
  match !IO.getArgs with
    ["index"] ->
      printLine
        ("evaluating " ++ Nat.toText (List.size upkg.index.attrs)
          ++ " attrs in one nix eval ...")
      !upkg.index.generate
      printLine "wrote src/nixpkgs-index.u"
    ["deep-hello"] ->
      rootDrv = upkg.Pinned.drv (upkg.resolveNixpkgs "hello")
      printLine ("importing closure of " ++ rootDrv ++ " ...")
      closure = upkg.importClosure rootDrv
      printLine ("  " ++ Nat.toText (Map.size closure) ++ " derivations")
      targets =
        List.foldLeft
          (acc -> cases (b, d) ->
            n = upkg.Drv.name d
            if (n Text.== "stdenv-linux")
              || (n Text.== "stdenv-linux-no-cc")
            then Set.insert b acc
            else acc)
          Set.empty
          (Map.toList closure)
      printLine
        ("  targets: " ++ Nat.toText (Set.size targets) ++ " stdenv drvs")
      marker = "echo '>>> hello from the unison graph rewrite <<<'"
      f = d -> let
        old =
          Optional.getOrElse "" (upkg.assoc.lookup "preHook" (upkg.Drv.env d))
        upkg.Drv.setEnv "preHook" (old ++ "\n" ++ marker) d
      marks = upkg.closure.markAll closure targets
      nAff = List.size (List.filter at2 (Map.toList marks))
      printLine ("  affected: " ++ Nat.toText nAff ++ " drvs to rewrite")
      (_, newRoot) =
        upkg.closure.rewrite closure marks targets f Map.empty
          (Text.drop 11 rootDrv)
      printLine ("building " ++ newRoot ++ " ...")
      out =
        upkg.nix
          ["build", "--no-link", "--print-out-paths", newRoot ++ "^out"]
          ""
      printLine ("out: " ++ upkg.chomp out)
    ["hexyl"] ->
      lock = readFileUtf8 (FilePath "fixtures/hexyl-0.16.0.Cargo.lock")
      up =
        upkg.cargo.pkg
          "hexyl"
          "0.16.0"
          "sha256-Q9Vt0EhytsbUKfGNLgPflfhT/rYYx82L8i0OaFHOXvg="
          lock
      printLine "realising hexyl (cargo, unison builder) ..."
      drv = upkg.realiseU up
      printLine ("building " ++ drv ++ " ...")
      out =
        upkg.nix
          ["build", "--no-link", "--print-out-paths", drv ++ "^out"]
          ""
      printLine ("out: " ++ upkg.chomp out)
    ["uni-hello"] ->
      printLine "importing nixpkgs#hello ..."
      d = upkg.importDrv "hello"
      d2 = upkg.Drv.caify (pkgs.uniHello.override d)
      drv = upkg.Drv.realise d2
      printLine ("  drv hello-uni -> " ++ drv)
      printLine ("building " ++ drv ++ " ...")
      out =
        upkg.nix
          ["build", "--no-link", "--print-out-paths", drv ++ "^out"]
          ""
      printLine ("out: " ++ upkg.chomp out)
    [pkgName] ->
      match upkg.assoc.lookup pkgName pkgs.registry with
        Some pkg ->
          printLine ("realising " ++ pkgName ++ " ...")
          drv = upkg.realise pkg
          printLine ("building " ++ drv ++ " ...")
          out =
            upkg.nix
              ["build", "--no-link", "--print-out-paths", drv ++ "^out"]
              ""
          printLine ("out: " ++ upkg.chomp out)
        None -> match upkg.assoc.lookup pkgName pkgs.uregistry with
          Some up ->
            printLine ("realising " ++ pkgName ++ " (unison builder) ...")
            drv = upkg.realiseU up
            printLine ("building " ++ drv ++ " ...")
            out =
              upkg.nix
                ["build", "--no-link", "--print-out-paths", drv ++ "^out"]
                ""
            printLine ("out: " ++ upkg.chomp out)
          None ->
            printLine
              ("unknown package: " ++ pkgName ++ " (known: "
                ++ Text.join
                    ", "
                    (List.map at1 pkgs.registry
                      ++ List.map at1 pkgs.uregistry)
                ++ ")")
    _ -> printLine "usage: upkg <package>"
