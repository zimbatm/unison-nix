-- nix-daemon worker protocol client. Pure codec + handshake +
-- one read-only probe (wopIsValidPath). Everything here typechecks
-- against @unison/base as-is; only `connect` needs the new
-- unixClientSocket builtin, so it is a parameter for now.

nixd.magic1 : Nat
nixd.magic1 = 0x6e697863

nixd.magic2 : Nat
nixd.magic2 = 0x6478696f

nixd.ourVersion : Nat
nixd.ourVersion = 0x0126  -- protocol 1.38: enables feature negotiation

-- The features we advertise. realisation-with-path-not-hash is
-- required to query content-addressed derivation outputs.
nixd.ourFeatures : [Text]
nixd.ourFeatures = ["realisation-with-path-not-hash"]

-- u64 little-endian, matching the daemon.
nixd.putNat : Nat -> Bytes
nixd.putNat = Bytes.encodeNat64le

-- A string: u64 length, the bytes, then zero-pad to an 8-byte
-- boundary.
nixd.putStr : Text -> Bytes
nixd.putStr t =
  bs = Text.toUtf8 t
  n = Bytes.size bs
  pad = Nat.mod (Nat.diff 8 (Nat.mod n 8)) 8
  padBytes = Bytes.fromList (List.replicate pad (do 0))
  Bytes.encodeNat64le n ++ bs ++ padBytes

-- Frame strings in this protocol are tiny (paths, versions, error
-- text). A read this large means a misaligned frame -- and since
-- Socket.receiveAtMost allocates its requested size eagerly, a huge
-- length would OOM the runtime instead of failing. Throw first so
-- the misalignment is a catchable error, not a crash.
nixd.maxRead : Nat
nixd.maxRead = 16777216   -- 16 MiB

-- Receive exactly n bytes, looping over receiveAtMost.
nixd.recvN : Socket -> Nat -> {IO, Exception} Bytes
nixd.recvN sock n =
  if Nat.gt n nixd.maxRead then
    Exception.raise
      (Generic.failure
        ("nixd: implausible read length " ++ Nat.toText n
          ++ " (misaligned frame)")
        ())
  else
    go = acc -> let
      got = Bytes.size acc
      if got >= n then Bytes.take n acc
      else
        chunk = Socket.receiveAtMost sock (Nat.diff n got)
        if Bytes.size chunk == 0 then
          Exception.raise (Generic.failure "nixd: socket closed early" ())
        else go (acc ++ chunk)
    go Bytes.empty

nixd.recvNat : Socket -> {IO, Exception} Nat
nixd.recvNat sock =
  match Bytes.decodeNat64le (nixd.recvN sock 8) with
    Some (n, _) -> n
    None -> Exception.raise (Generic.failure "nixd: short read" ())

nixd.recvStr : Socket -> {IO, Exception} Text
nixd.recvStr sock =
  n = nixd.recvNat sock
  bs = nixd.recvN sock n
  pad = Nat.mod (Nat.diff 8 (Nat.mod n 8)) 8
  _ = if pad > 0 then nixd.recvN sock pad else Bytes.empty
  Text.fromUtf8 bs

-- Read and discard a length-prefixed string WITHOUT decoding.
-- Build-log lines and activity fields in the stderr stream are not
-- guaranteed to be valid UTF-8, so processStderr must not decode
-- the strings it only skips.
nixd.skipStr : Socket -> {IO, Exception} ()
nixd.skipStr sock =
  n = nixd.recvNat sock
  _ = nixd.recvN sock n
  pad = Nat.mod (Nat.diff 8 (Nat.mod n 8)) 8
  _ = if pad > 0 then nixd.recvN sock pad else Bytes.empty
  ()

-- STDERR_LAST = 0x616c7473 ; STDERR_ERROR = 0x63787470.
-- The daemon interleaves log messages before each reply; drain
-- them until LAST, raising on ERROR.
nixd.processStderr : Socket -> {IO, Exception} ()
nixd.processStderr sock =
  loop = do
    tag = nixd.recvNat sock
    if tag == 0x616c7473 then ()          -- LAST
    else if tag == 0x63787470 then         -- ERROR: a structured Error;
      -- fields: type, level, name, msg (the human message), ...
      _typ = nixd.recvStr sock
      _lvl = nixd.recvNat sock
      _name = nixd.recvStr sock
      msg = nixd.recvStr sock
      Exception.raise (Generic.failure ("nixd error: " ++ msg) ())
    else if tag == 0x6f6c6d67 then         -- NEXT: a log line
      nixd.skipStr sock
      !loop
    else if tag == 0x53545254 then         -- START_ACTIVITY (build)
      _act = nixd.recvNat sock
      _lvl = nixd.recvNat sock
      _typ = nixd.recvNat sock
      nixd.skipStr sock
      nixd.readFields sock
      _parent = nixd.recvNat sock
      !loop
    else if tag == 0x53544f50 then         -- STOP_ACTIVITY
      _act = nixd.recvNat sock
      !loop
    else if tag == 0x52534c54 then         -- RESULT
      _act = nixd.recvNat sock
      _rtyp = nixd.recvNat sock
      nixd.readFields sock
      !loop
    else                                    -- unknown: a single string
      nixd.skipStr sock
      !loop
  !loop

-- A logger field list: count, then each is (type, int|string).
-- Explicit recursion (not List.range) so a zero-field frame reads
-- exactly zero fields -- an off-by-one here misaligns the whole
-- build stream.
nixd.readFields : Socket -> {IO, Exception} ()
nixd.readFields sock =
  n = nixd.recvNat sock
  nixd.readFields.go sock n 0

nixd.readFields.go : Socket -> Nat -> Nat -> {IO, Exception} ()
nixd.readFields.go sock n i =
  if i >= n then ()
  else
    ty = nixd.recvNat sock
    _ =
      if ty == 0 then nixd.recvNat sock
      else
        nixd.skipStr sock
        0
    nixd.readFields.go sock n (i + 1)

-- After an addToStore response's path, the daemon sends the rest of
-- a ValidPathInfo. Leaving it unread offsets the NEXT op -- the bug
-- that misaligned every add-then-build sequence. Consume it all.
nixd.skipPathInfoTail : Socket -> {IO, Exception} ()
nixd.skipPathInfoTail sock =
  nixd.skipStr sock         -- deriver (optional store path, "" if none)
  nixd.skipStr sock         -- narHash (base16)
  nixd.skipStrings sock     -- references
  _ = nixd.recvNat sock     -- registrationTime
  _ = nixd.recvNat sock     -- narSize
  _ = nixd.recvNat sock     -- ultimate  (>= 1.16)
  nixd.skipStrings sock     -- sigs      (>= 1.16)
  nixd.skipStr sock         -- ca        (>= 1.16)

-- Read and skip a string set: count, then each string.
nixd.skipStrings : Socket -> {IO, Exception} ()
nixd.skipStrings sock = nixd.skipStrings.go sock (nixd.recvNat sock) 0

nixd.skipStrings.go : Socket -> Nat -> Nat -> {IO, Exception} ()
nixd.skipStrings.go sock n i =
  if i >= n then ()
  else
    nixd.skipStr sock
    nixd.skipStrings.go sock n (i + 1)

-- Handshake at protocol 1.38, then return the negotiated version.
-- Sequence from NixOS/nix worker-protocol-connection.cc:
-- magic1+version, read magic2+daemonVersion, exchange feature sets
-- (>=1.38), send obsolete cpu-affinity + reserve, read
-- ClientHandshakeInfo (version string >=1.33, trust flag >=1.35),
-- then processStderr.
nixd.handshake : Socket -> {IO, Exception} Nat
nixd.handshake sock =
  Socket.send sock (nixd.putNat nixd.magic1)
  Socket.send sock (nixd.putNat nixd.ourVersion)
  m2 = nixd.recvNat sock
  if Nat.eq m2 nixd.magic2 |> not then
    Exception.raise (Generic.failure "nixd: bad magic from daemon" ())
  else
    daemonV = nixd.recvNat sock
    -- >=1.38: send our feature set, read the daemon's.
    Socket.send sock (nixd.putPaths nixd.ourFeatures)
    nixd.skipStrings sock
    -- obsolete cpu-affinity nat (>=1.14); reserve-space flag (>=1.11)
    Socket.send sock (nixd.putNat 0)
    Socket.send sock (nixd.putNat 0)
    -- ClientHandshakeInfo: daemon version string, then trust flag.
    nixd.skipStr sock
    _trust = nixd.recvNat sock
    nixd.processStderr sock
    daemonV

-- wopIsValidPath = 1. The end-to-end probe: does the store have
-- this path? Proves framing without NAR serialization.
nixd.isValidPath : Socket -> Text -> {IO, Exception} Boolean
nixd.isValidPath sock path =
  Socket.send sock (nixd.putNat 1)
  Socket.send sock (nixd.putStr path)
  nixd.processStderr sock
  Nat.gt (nixd.recvNat sock) 0

-- The whole probe, parameterised on connect (= unixClientSocket).
nixd.probe : (Text -> {IO, Exception} Socket) -> Text -> {IO, Exception} ()
nixd.probe connect storePath =
  sock = connect "/nix/var/nix/daemon-socket/socket"
  v = nixd.handshake sock
  printLine ("daemon protocol " ++ Nat.toText v)
  ok = nixd.isValidPath sock storePath
  printLine (storePath ++ " valid? " ++ (if ok then "yes" else "no"))

-- ----------------------------------------------------------------
-- Write path. Field order taken from NixOS/nix 2.24
-- remote-store.cc (addCAToStore), not guessed. Opcodes from
-- worker-protocol.hh: AddToStore = 7, BuildPaths = 9,
-- EnsurePath = 10, QueryValidPaths = 31.

-- A store-path set: u64 count, then each path string.
nixd.putPaths : [Text] -> Bytes
nixd.putPaths paths =
  List.foldLeft
    (acc -> p -> acc ++ nixd.putStr p)
    (nixd.putNat (List.size paths))
    paths

-- A FramedSink body: the payload in one frame (u64 length + bytes)
-- terminated by a zero-length frame.
nixd.putFramed : Bytes -> Bytes
nixd.putFramed payload =
  nixd.putNat (Bytes.size payload) ++ payload ++ nixd.putNat 0

-- wopAddToStore for a NAR-serialized object. caMethod string is
-- "nar:sha256"; the daemon computes the path from the NAR hash,
-- so we still never compute a store path. Returns the path the
-- daemon reports.
nixd.addToStore :
  Socket -> Text -> [Text] -> nar.Fs -> {IO, Exception} Text
nixd.addToStore sock name references fs =
  Socket.send sock (nixd.putNat 7)             -- Op::AddToStore
  Socket.send sock (nixd.putStr name)
  Socket.send sock (nixd.putStr "fixed:r:sha256")  -- recursive NAR, sha256
  Socket.send sock (nixd.putPaths references)
  Socket.send sock (nixd.putNat 0)             -- repair = false
  Socket.send sock (nixd.putFramed (nar.dump fs))
  nixd.processStderr sock
  -- Response is a ValidPathInfo: read the path, then consume the
  -- rest so the next op stays aligned.
  path = nixd.recvStr sock
  nixd.skipPathInfoTail sock
  path

-- Flat add: raw file bytes, not a NAR. Matches
-- `nix store add --mode flat` -- exactly what upkg's ship path does
-- for the .uv envelope and the runner bytecode.
nixd.addToStoreFlat : Socket -> Text -> Bytes -> {IO, Exception} Text
nixd.addToStoreFlat sock name bytes =
  Socket.send sock (nixd.putNat 7)             -- Op::AddToStore
  Socket.send sock (nixd.putStr name)
  Socket.send sock (nixd.putStr "fixed:sha256") -- flat, not recursive
  Socket.send sock (nixd.putPaths [])
  Socket.send sock (nixd.putNat 0)             -- repair = false
  Socket.send sock (nixd.putFramed bytes)
  nixd.processStderr sock
  path = nixd.recvStr sock
  nixd.skipPathInfoTail sock
  path
